---
import BaseLayout from '../layouts/BaseLayout.astro'
import UnitGrid from '../components/UnitGrid.astro'
import Catalogue from '../components/Catalogue.astro'
import { committee } from '../data/committee'
import fs from 'node:fs'

const meta = JSON.parse(fs.readFileSync('public/data/meta.json', 'utf-8'))
const resolutions = JSON.parse(fs.readFileSync('public/data/resolutions.json', 'utf-8'))
const standards = JSON.parse(fs.readFileSync('public/data/standards.json', 'utf-8'))

const latest = meta.latest_plenary
const latestDecisions = (resolutions.plenary.find((p) => p.ordinal === latest.ordinal) || { decisions: [] }).decisions
const published = standards.filter((s) => s.status === 'published')

function ordinal(n) {
  const s = ['th', 'st', 'nd', 'rd']
  const v = n % 100
  return n + (s[(v - 20) % 10] || s[v] || s[0])
}

const nextDate = new Date('2027-05-25')
const today = new Date()
const daysUntil = Math.max(0, Math.ceil((nextDate - today) / (1000 * 60 * 60 * 24)))
---

<BaseLayout
  title="Quantities and units"
  description="ISO/TC 12 maintains the ISO 80000 series — the International System of Quantities, giving every quantity its name, symbol, and unit across all domains of science and technology."
>
  <article class="page home">
    {/* HERO */}
    <header class="hero">
      <p class="eyebrow rise rise-1">
        <span>{committee.name}</span>
        <span class="hero__eyebrow-sep">·</span>
        <span>since {committee.established}</span>
        <span class="hero__eyebrow-sep">·</span>
        <span>Secretariat {committee.secretariat}</span>
      </p>

      <h1 class="hero__title rise rise-2">
        Quantities,{' '}
        <span class="hero__title-em">named.</span>
      </h1>

      <p class="hero__lead rise rise-3">
        Every measurement in science, engineering, and trade rests on a shared vocabulary of <em>quantities</em> and <em>units</em>. ISO/TC 12 maintains the <strong>International System of Quantities</strong> — the names, symbols, and definitions published as the ISO 80000 series.
      </p>

      <div class="hero__actions rise rise-4">
        <a href="/standards/" class="btn btn--ref">Browse ISO 80000 →</a>
        <a href="/about/" class="btn btn--ghost">About the committee</a>
      </div>
    </header>

    {/* CATALOGUE — THE SIGNATURE */}
    <Catalogue />

    {/* STATS */}
    <section class="stats-block" aria-label="At a glance">
      <dl class="stats">
        <a href="/standards/" class="stat">
          <dt class="stat__label">Standards</dt>
          <dd class="stat__value num">{meta.counts.standards}</dd>
          <dd class="stat__caption">ISO/IEC 80000 parts naming quantities across science and technology.</dd>
        </a>
        <a href="/decisions/" class="stat">
          <dt class="stat__label">Resolutions</dt>
          <dd class="stat__value num">{meta.counts.decisions}</dd>
          <dd class="stat__caption">From 2010 to present, every committee decision.</dd>
        </a>
        <a href="/national-bodies/" class="stat">
          <dt class="stat__label">Member bodies</dt>
          <dd class="stat__value num">{meta.counts.p_members}</dd>
          <dd class="stat__caption">Participating national bodies shaping the work.</dd>
        </a>
        <a href="/history/" class="stat">
          <dt class="stat__label">Plenaries</dt>
          <dd class="stat__value num">{meta.counts.plenaries}</dd>
          <dd class="stat__caption">{ordinal(latest.ordinal)} meeting held {new Date(latest.date).getFullYear()}.</dd>
        </a>
      </dl>
    </section>

    {/* LATEST + NEXT */}
    <section class="two-up" aria-label="Recent and next">
      <div class="latest">
        <header class="block-head">
          <p class="eyebrow">Latest plenary</p>
          <h2 class="block-title">
            <a href={latest.landing_url} class="block-title__link">
              {ordinal(latest.ordinal)} meeting{' '}
              <span class="block-title__sep">·</span>{' '}
              <time datetime={latest.date}>{new Date(latest.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
            </a>
          </h2>
          <p class="block-lead">{latest.general_area}. {latest.decision_count} resolutions adopted.</p>
        </header>
        <ol class="res-list">
          {latestDecisions.slice(0, 5).map((d) => (
            <li class="res-list__item">
              <a href={`/decisions/${d.urn}`} class="res">
                <span class="res__num num">{d.number}</span>
                <span class="res__title">{d.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <aside class="next-card">
        <p class="eyebrow eyebrow--ref">Next</p>
        <h3 class="next-card__title">24th plenary</h3>
        <p class="next-card__date">
          <time datetime="2027-05-25">25 May 2027</time>
          <span class="next-card__time">13:00 CEST</span>
        </p>
        <div class="next-card__count">
          <span class="next-card__days num">{daysUntil.toLocaleString()}</span>
          <span class="next-card__days-label">days</span>
        </div>
        <p class="next-card__note">Virtual via Zoom. A member body may offer to host in person.</p>
        <a href="/meetings/" class="next-card__link">Meeting details →</a>
      </aside>
    </section>

    {/* SERIES */}
    <section aria-label="ISO 80000 series">
      <header class="block-head">
        <p class="eyebrow">The series</p>
        <h2 class="block-title">ISO/IEC 80000 in brief</h2>
      </header>
      <div class="std-grid">
        {published.slice(0, 6).map((s) => (
          <a href={`/standards/${s.slug}/`} class="std-card">
            <div class="std-card__head">
              <span class="std-card__ref num">{`ISO ${s.part >= 14 && s.part <= 17 ? 'IEC ' : ''}80000-${s.part}`}</span>
              <span class="std-card__year num">{s.edition_year ?? 'TBD'}</span>
            </div>
            <h3 class="std-card__title">{s.title}</h3>
            <p class="std-card__scope">{s.scope}</p>
          </a>
        ))}
      </div>
      <p class="block-foot">
        <a href="/standards/" class="btn btn--ghost">All {standards.length} parts →</a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  /* === HERO === */
  .hero {
    padding: 2rem 0 4rem;
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: 0;
  }
  .hero__eyebrow-sep { color: var(--ink-faint); margin: 0 0.5rem; }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 7rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin: 1.5rem 0 0;
    max-width: 14ch;
  }
  .hero__title-em {
    font-style: italic;
    color: var(--accent);
    font-weight: 400;
  }
  .hero__lead {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.5vw, 1.5rem);
    line-height: 1.5;
    color: var(--ink-secondary);
    margin: 2rem 0 0;
    max-width: 52ch;
  }
  .hero__lead em { font-style: italic; }
  .hero__lead strong { color: var(--ink); font-weight: 600; }
  .hero__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  /* === STATS === */
  .stats-block {
    border-bottom: 1px solid var(--rule-strong);
    padding: 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 0;
  }
  @media (min-width: 768px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stat {
    display: block;
    padding: 2rem 1.5rem 2rem 0;
    text-decoration: none;
    color: var(--ink);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    transition: background 0.15s;
  }
  @media (min-width: 768px) {
    .stat { padding: 2.5rem 1.5rem; border-bottom: 0; }
    .stat:last-child { border-right: 0; }
  }
  .stat:nth-child(2n) { border-right: 0; }
  @media (min-width: 768px) {
    .stat:nth-child(2n) { border-right: 1px solid var(--rule); }
  }
  .stat:hover { background: var(--bg-elevated); color: var(--ink); }
  .stat__label {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.75rem;
  }
  .stat__value {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
    font-size: 2.75rem;
    line-height: 1;
    color: var(--ink);
    margin: 0 0 0.625rem;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .stat__caption {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    line-height: 1.5;
    margin: 0;
    max-width: 24ch;
  }

  /* === Block heads === */
  .block-head { margin: 4rem 0 2rem; max-width: 56ch; }
  .block-title {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 2.5vw, 2.25rem);
    font-weight: 500;
    color: var(--ink);
    margin: 0.625rem 0 0.625rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .block-title__link { color: inherit; text-decoration: none; }
  .block-title__link:hover { color: var(--accent); }
  .block-title__sep { color: var(--ink-faint); margin: 0 0.5rem; font-weight: 300; }
  .block-title time { font-family: var(--font-mono); font-size: 0.875em; font-weight: 500; color: var(--ink-secondary); }
  .block-lead {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-secondary);
    margin: 0;
  }
  .block-foot { margin: 2rem 0 0; }

  /* === Two-up === */
  .two-up {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-top: 4rem;
    margin-top: 4rem;
    border-top: 1px solid var(--rule-strong);
  }
  @media (min-width: 1024px) {
    .two-up { grid-template-columns: 1.7fr 1fr; gap: 3rem; }
  }

  .res-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule); }
  .res-list__item { border-bottom: 1px solid var(--rule); }
  .res {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 0.875rem 0;
    color: var(--ink-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }
  .res:hover { color: var(--accent); }
  .res__num {
    font-family: var(--font-mono);
    font-feature-settings: 'tnum';
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .res__title { font-size: 0.9375rem; line-height: 1.5; }

  .next-card {
    background: var(--ink);
    color: var(--bg);
    padding: 2rem;
    border-radius: 0.5rem;
    align-self: start;
  }
  .next-card .eyebrow { color: color-mix(in srgb, var(--bg) 55%, transparent) !important; }
  .next-card__title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    margin: 0.75rem 0 0;
    color: var(--bg);
    letter-spacing: -0.02em;
  }
  .next-card__date {
    margin: 0.375rem 0 0;
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--bg) 85%, transparent);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .next-card__time { color: color-mix(in srgb, var(--bg) 55%, transparent); font-family: var(--font-mono); font-size: 0.8125rem; }
  .next-card__count {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin: 1.5rem 0;
    padding: 1.25rem 0;
    border-top: 1px solid color-mix(in srgb, var(--bg) 18%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--bg) 18%, transparent);
  }
  .next-card__days {
    font-family: var(--font-mono);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--bg);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .next-card__days-label {
    font-size: 0.875rem;
    color: color-mix(in srgb, var(--bg) 55%, transparent);
  }
  .next-card__note {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--bg) 70%, transparent);
    margin: 0 0 1rem;
  }
  .next-card__link {
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* === Standards grid === */
  .std-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  @media (min-width: 768px) { .std-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .std-grid { grid-template-columns: repeat(3, 1fr); } }
  .std-card {
    background: var(--bg);
    padding: 1.5rem;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.18s;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .std-card:hover { background: var(--bg-elevated); color: var(--ink); }
  .std-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .std-card__ref {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }
  .std-card__year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
  .std-card__title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0.5rem 0 0;
    letter-spacing: -0.015em;
  }
  .std-card:hover .std-card__title { color: var(--accent); }
  .std-card__scope {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0.375rem 0 0;
  }
</style>
