---
import BaseLayout from '../../layouts/BaseLayout.astro'
import fs from 'node:fs'

export function getStaticPaths() {
  const resolutions = JSON.parse(fs.readFileSync('public/data/resolutions.json', 'utf-8'))
  const allDecisions = [
    ...resolutions.plenary.flatMap((p) =>
      p.decisions.map((d) => ({ ...d, source: `Plenary ${p.ordinal}`, source_date: p.date }))
    ),
    ...resolutions.ballots.flatMap((b) =>
      b.decisions.map((d) => ({ ...d, source: b.id, source_date: b.date }))
    ),
  ]
  return allDecisions.map((d) => ({
    params: { id: d.number },
    props: { decision: d },
  }))
}

const { decision: d } = Astro.props
---

<BaseLayout title={`${d.number} — ${d.title}`} description={d.title}>
  <article class="page">
    <a href="/decisions/" class="back-link">← All resolutions</a>

    <header class="decision-head">
      <p class="eyebrow eyebrow--ref">{d.identifier}</p>
      <h1 class="decision-head__title">{d.title}</h1>
    </header>

    <div class="decision-grid">
      <aside>
        <dl class="decision-meta">
          {d.dates?.[0]?.date && (
            <div><dt>Adopted</dt><dd class="num">{d.dates[0].date}</dd></div>
          )}
          <div><dt>Kind</dt><dd>{d.kind}</dd></div>
          <div><dt>Status</dt><dd>{d.status}</dd></div>
          <div><dt>Source</dt><dd>{d.source}</dd></div>
          {d.urn && <div><dt>URN</dt><dd class="num small">{d.urn}</dd></div>}
        </dl>

        {d.categories?.length > 0 && (
          <div class="decision-cats">
            <p class="eyebrow">Categories</p>
            <ul>
              {d.categories.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        )}
      </aside>

      <section class="decision-body">
        <p class="eyebrow">Resolution</p>
        <div class="prose-ref">
          {d.categories?.length > 0 && (
            <p class="decision-context">{d.categories[0]}</p>
          )}
          <p>{d.title}</p>
          <p class="muted">Full resolution text is available in the source document. See the committee document repository for the complete text with all actions, approvals, and considerations.</p>
        </div>

        <p style="margin-top: 2rem;">
          <a href="/decisions/" class="btn btn--ghost">← All resolutions</a>
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .back-link { display: inline-block; font-size: 0.8125rem; color: var(--ink-muted); text-decoration: none; margin-bottom: 2rem; font-family: var(--font-mono); }
  .back-link:hover { color: var(--accent); }

  .decision-head { padding-bottom: 2rem; border-bottom: 1px solid var(--rule-strong); margin-bottom: 3rem; }
  .decision-head__title { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; color: var(--ink); margin: 0.75rem 0 0; }

  .decision-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 1024px) { .decision-grid { grid-template-columns: 1fr 2fr; gap: 4rem; } }

  .decision-meta { margin: 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .decision-meta dt { font-size: 0.6875rem; font-weight: 600; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.375rem; }
  .decision-meta dd { margin: 0; font-size: 0.9375rem; color: var(--ink); }
  .decision-meta dd.num { font-family: var(--font-mono); font-size: 0.875rem; }
  .decision-meta dd.small { font-size: 0.75rem; word-break: break-all; }

  .decision-cats { margin-top: 2rem; }
  .decision-cats ul { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; flex-direction: column; gap: 0.375rem; }
  .decision-cats li { font-size: 0.8125rem; color: var(--ink-secondary); padding: 0.375rem 0.625rem; background: var(--bg-elevated); border-radius: 0.25rem; }

  .decision-context { font-style: italic; color: var(--ink-muted); font-family: var(--font-display); }
  .muted { color: var(--ink-muted); }
</style>
