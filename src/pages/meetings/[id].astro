---
import BaseLayout from '../../layouts/BaseLayout.astro'
import fs from 'node:fs'

export function getStaticPaths() {
  const events = JSON.parse(fs.readFileSync('public/data/events.json', 'utf-8'))
  return events.map((e) => ({
    params: { id: `plenary-${e.ordinal}` },
    props: { event: e },
  }))
}

const { event: e } = Astro.props
const resolutions = JSON.parse(fs.readFileSync('public/data/resolutions.json', 'utf-8'))
const meetingResolutions = (resolutions.plenary.find((p) => p.ordinal === e.ordinal) || { decisions: [] }).decisions

function ordinal(n) {
  const s = ['th', 'st', 'nd', 'rd']
  const v = n % 100
  return n + (s[(v - 20) % 10] || s[v] || s[0])
}

const dateFrom = e.time?.from?.date ? new Date(e.time.from.date) : null
const dateTo = e.time?.to?.date ? new Date(e.time.to.date) : null
const dateRange = dateFrom && dateTo && dateFrom.getTime() !== dateTo.getTime()
  ? `${dateFrom.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}–${dateTo.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}`
  : dateFrom ? dateFrom.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : ''
---

<BaseLayout title={`${ordinal(e.ordinal)} plenary meeting`} description={`${e.title} — ${e.general_area}, ${dateRange}.`}>
  <article class="page">
    <a href="/meetings/" class="back-link">← All meetings</a>

    <header class="meeting-head">
      <p class="eyebrow eyebrow--ref">Meeting {e.ordinal} · {e.year}</p>
      <h1 class="meeting-head__title">{e.title}</h1>
      <p class="meeting-head__lead">
        {dateRange}{e.general_area && ` · ${e.general_area}`}{e.host && ` · hosted by ${e.host}`}
      </p>
    </header>

    <div class="meeting-grid">
      <section>
        <p class="eyebrow">Details</p>
        <dl class="meeting-meta">
          {dateFrom && (
            <div>
              <dt>Date</dt>
              <dd class="num">{dateRange}</dd>
            </div>
          )}
          {e.general_area && (
            <div>
              <dt>Location</dt>
              <dd>{e.general_area}</dd>
            </div>
          )}
          {e.host && (
            <div>
              <dt>Host</dt>
              <dd>{e.host}</dd>
            </div>
          )}
          {e.chair?.name && (
            <div>
              <dt>Chair</dt>
              <dd>{e.chair.name}{e.acting_chair_at_meeting && <span class="muted"> (acting: {e.acting_chair_at_meeting})</span>}</dd>
            </div>
          )}
          {e.committee_manager && (
            <div>
              <dt>Committee Manager</dt>
              <dd>{e.committee_manager}</dd>
            </div>
          )}
        </dl>

        {e.attendance?.countries && (
          <div class="meeting-countries">
            <p class="eyebrow">Attendance</p>
            <div class="country-list">
              {e.attendance.countries.map((c) => (
                <span class:list={['country', c.attended === false && 'country--absent']}>
                  {c.code}
                </span>
              ))}
            </div>
          </div>
        )}
      </section>

      <section class="meeting-decisions">
        <p class="eyebrow">Resolutions ({meetingResolutions.length})</p>
        {meetingResolutions.length > 0 ? (
          <ol class="res-list">
            {meetingResolutions.map((d) => (
              <li class="res-list__item">
                <a href={`/decisions/${d.number}/`} class="res">
                  <span class="res__num num">{d.number}</span>
                  <span class="res__title">{d.title}</span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="muted">No resolutions transcribed for this meeting.</p>
        )}
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .back-link { display: inline-block; font-size: 0.8125rem; color: var(--ink-muted); text-decoration: none; margin-bottom: 2rem; font-family: var(--font-mono); }
  .back-link:hover { color: var(--accent); }

  .meeting-head { padding-bottom: 2rem; border-bottom: 1px solid var(--rule-strong); margin-bottom: 3rem; }
  .meeting-head__title { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; line-height: 1.1; letter-spacing: -0.025em; color: var(--ink); margin: 0.75rem 0 0; }
  .meeting-head__lead { font-family: var(--font-display); font-size: 1.1875rem; line-height: 1.55; color: var(--ink-secondary); margin: 1rem 0 0; }

  .meeting-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 1024px) { .meeting-grid { grid-template-columns: 1fr 2fr; gap: 4rem; } }

  .meeting-meta { margin: 1rem 0 0; display: flex; flex-direction: column; gap: 1.25rem; }
  .meeting-meta dt { font-size: 0.6875rem; font-weight: 600; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.375rem; }
  .meeting-meta dd { margin: 0; font-size: 0.9375rem; color: var(--ink); }
  .muted { color: var(--ink-muted); font-size: 0.875rem; }

  .meeting-countries { margin-top: 2rem; }
  .country-list { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.75rem; }
  .country { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; padding: 0.1875rem 0.4375rem; border: 1px solid var(--rule); border-radius: 0.25rem; color: var(--ink-secondary); }
  .country--absent { opacity: 0.4; text-decoration: line-through; }

  .res-list { list-style: none; padding: 0; margin: 1rem 0 0; border-top: 1px solid var(--rule); }
  .res-list__item { border-bottom: 1px solid var(--rule); }
  .res { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 0.875rem 0; color: var(--ink-secondary); text-decoration: none; transition: color 0.15s; }
  .res:hover { color: var(--accent); }
  .res__num { font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500; color: var(--accent); }
  .res__title { font-size: 0.9375rem; line-height: 1.5; }
</style>
