---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import { committee } from '../data/committee'
---

<BaseLayout title="About — ISO/TC 12" description="About ISO/TC 12 — Quantities and units.">
  <PageHero
    variant="index"
    bleed
    eyebrow="About"
    title="ISO/TC 12"
    lead="Standardization of units and symbols for quantities and units (and mathematical symbols) used within the different fields of science and technology."
  />

  <div class="page page--wide">
    <section class="about-section">
      <header class="about-section__head"><h2>General</h2></header>
      <div class="about-section__body">
        <dl class="facts">
          <div><dt>Name</dt><dd>{committee.title}</dd></div>
          <div><dt>Secretariat</dt><dd>{committee.secretariat}</dd></div>
          <div><dt>Chair</dt><dd>{committee.chair}</dd></div>
          <div><dt>Committee Manager</dt><dd>{committee.committee_manager}</dd></div>
          <div><dt>Creation date</dt><dd>{committee.established}</dd></div>
        </dl>
      </div>
    </section>

    <section class="about-section">
      <header class="about-section__head"><h2>Mission</h2></header>
      <div class="about-section__body">
        <p>In society, processes and products acquire better interoperability, improved communication, and can be more reliably traded when measurement is expressed in terms of harmonised units and symbols. Harmonised treatment of quantities and units facilitates the route to market for innovative products and services of all kinds.</p>
        <p>TC 12 is charged with the standardization of units and symbols for quantities and units (and mathematical symbols) used within the different fields of science and technology, giving, where necessary, definitions of these quantities and units. Standard conversion factors between the various units.</p>
      </div>
    </section>

    <section class="about-section">
      <header class="about-section__head"><h2>Scope</h2></header>
      <div class="about-section__body">
        <p>{committee.scope}</p>
      </div>
    </section>

    <section class="about-section">
      <header class="about-section__head"><h2>The ISO 80000 series</h2></header>
      <div class="about-section__body">
        <p>The committee's principal work is the <strong>ISO/IEC 80000</strong> series — quantities and units across mathematics, space and time, mechanics, thermodynamics, electromagnetism, light, acoustics, physical chemistry, atomic and nuclear physics, characteristic numbers, condensed matter, and information science.</p>
        <p>TC 12 coordinates with <strong>BIPM</strong> (the SI Brochure), <strong>JCGM</strong> (the VIM and GUM), <strong>IEC/TC 25</strong> (electrical and information-science quantities), and many ISO committees that consume its work.</p>
        <p>There is a division of labour between handling the International System of Units (CGPM/BIPM) and the International System of Quantities (ISO/TC 12).</p>
      </div>
    </section>

    <section class="about-section">
      <header class="about-section__head"><h2>Working Groups</h2></header>
      <div class="about-section__body">
        <ul class="wg-list">
          <li><strong>WG 21</strong> — General (revision of ISO 80000-1)</li>
          <li><strong>JWG 2</strong> — Joint with IEC/TC 25 (revision of IEC parts of ISO/IEC 80000 series)</li>
        </ul>
        <p><a href="/groups/" class="text-link">See all groups →</a></p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-section { max-width: 48rem; margin: 0 auto 2.5rem; padding: 0 1.5rem; }
  @media (min-width: 1024px) { .about-section { padding: 0 2rem; } }
  .about-section__head { padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem; }
  .about-section__head h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: var(--ink); margin: 0; letter-spacing: -0.015em; }
  .about-section__body { font-size: 0.9375rem; line-height: 1.7; color: var(--ink-secondary); }
  .about-section__body p { margin: 0 0 1rem; }
  .about-section__body p:last-child { margin-bottom: 0; }
  .about-section__body strong { color: var(--ink); font-weight: 600; }

  .facts { display: grid; grid-template-columns: 1fr; gap: 0.75rem; margin: 0; }
  @media (min-width: 640px) { .facts { grid-template-columns: 1fr 1fr; } }
  .facts div { display: flex; flex-direction: column; gap: 0.125rem; }
  .facts dt { font-size: 0.6875rem; font-weight: 600; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .facts dd { margin: 0; font-size: 0.9375rem; color: var(--ink); font-weight: 500; }

  .wg-list { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .wg-list li { font-size: 0.9375rem; color: var(--ink-secondary); }
  .wg-list strong { color: var(--accent); }

  .text-link { color: var(--accent); text-decoration: none; font-weight: 500; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
