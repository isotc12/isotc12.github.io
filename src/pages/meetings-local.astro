---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import fs from 'node:fs'

const events = JSON.parse(fs.readFileSync('public/data/events.json', 'utf-8'))
const resolutions = JSON.parse(fs.readFileSync('public/data/resolutions.json', 'utf-8'))

const plenaryWithCounts = events.map((e) => {
  const reso = resolutions.plenary.find((p) => p.ordinal === e.ordinal)
  return { ...e, decisions: reso?.decisions ?? [], decision_count: reso?.decision_count ?? 0 }
})
---

<BaseLayout title="Plenary meetings (local list)" description="Local list of TC 12 plenary meetings. For the canonical decision-browser view, see /decisions/ and /meetings/ (powered by @edoxen/browser)." noIndex={true}>
  <div class="max-w-[1320px] mx-auto px-6 lg:px-10 pt-12">
    <PageHero
      eyebrow="Meetings"
      ordinal="—"
      title="Plenary meetings (local)"
      lede="Full-featured decision and meeting browsers are at <a href='/decisions/' class='text-wine underline'>/decisions/</a> and <a href='/meetings/' class='text-wine underline'>/meetings/</a> — powered by <code class='font-mono'>@edoxen/browser</code>. This page is a thin local index kept in sync with the data."
    />
  </div>

  <section class="max-w-[1320px] mx-auto px-6 lg:px-10 mt-12">
    <div class="hairline pt-6">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left">
            <th class="eyebrow font-normal py-2">Ordinal</th>
            <th class="eyebrow font-normal py-2">Date</th>
            <th class="eyebrow font-normal py-2">Title</th>
            <th class="eyebrow font-normal py-2 hidden md:table-cell">Location</th>
            <th class="eyebrow font-normal py-2">Decisions</th>
          </tr>
        </thead>
        <tbody>
          {plenaryWithCounts.map((e) => (
            <tr class="hairline hover:bg-vellum/50">
              <td class="py-3 pr-4 font-mono text-wine align-top">{e.ordinal}</td>
              <td class="py-3 pr-4 font-mono text-xs text-muted align-top">
                {new Date(e.time?.from?.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
              </td>
              <td class="py-3 pr-4 align-top">
                <a href={e.landing_url} class="font-display hover:text-wine">{e.title}</a>
              </td>
              <td class="py-3 pr-4 text-muted text-sm hidden md:table-cell align-top">{e.general_area}</td>
              <td class="py-3 font-mono text-xs align-top">{e.decision_count}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
