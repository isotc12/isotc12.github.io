---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import { committee } from '../data/committee'
---

<BaseLayout title="Contact" description="How to reach ISO/TC 12 — secretariat held by SIS (Sweden).">
  <div class="max-w-[1320px] mx-auto px-6 lg:px-10 pt-12">
    <PageHero
      eyebrow="Contact"
      ordinal="09"
      title="Reach the committee"
      lede="The secretariat is held by SIS, Sweden. For matters about the committee, contact the committee manager."
    />
  </div>

  <section class="max-w-[1320px] mx-auto px-6 lg:px-10 mt-16">
    <div class="hairline pt-8 grid grid-cols-1 md:grid-cols-12 gap-12">
      <div class="md:col-span-6">
        <div class="eyebrow">Secretariat</div>
        <h3 class="font-display text-2xl font-medium mt-3">{committee.secretariat}</h3>
        <dl class="mt-6 text-sm space-y-4">
          <div>
            <dt class="text-muted">Committee Manager</dt>
            <dd class="font-display text-lg mt-1">{committee.committee_manager}</dd>
          </div>
          <div>
            <dt class="text-muted">Email</dt>
            <dd class="mt-1"><a href={`mailto:${committee.secretariat_email}`} class="font-mono text-wine hover:text-wine-deep border-b border-wine pb-0.5">{committee.secretariat_email}</a></dd>
          </div>
        </dl>
      </div>

      <div class="md:col-span-6 md:border-l md:border-rule md:pl-12">
        <div class="eyebrow">ISO channels</div>
        <ul class="mt-3 space-y-3 text-sm">
          <li>
            <a href={committee.links.isoCommittee} class="block hover:text-wine">
              <div class="font-display text-base">ISO committee page ↗</div>
              <div class="text-xs text-muted mt-1">Official ISO/TC 12 entry on iso.org</div>
            </a>
          </li>
          <li>
            <a href={committee.links.committeeSite} class="block hover:text-wine">
              <div class="font-display text-base">ISO committee site ↗</div>
              <div class="text-xs text-muted mt-1">All committee documents — restricted to member body login</div>
            </a>
          </li>
          <li>
            <a href="https://www.iso.org/meetings.html" class="block hover:text-wine">
              <div class="font-display text-base">ISO Meetings ↗</div>
              <div class="text-xs text-muted mt-1">Upcoming TC 12 meetings and registration</div>
            </a>
          </li>
        </ul>

        <div class="eyebrow mt-10">For ISO member bodies</div>
        <p class="text-sm text-muted mt-2">
          Member bodies conduct formal correspondence through the ISO Global
          Directory. Individuals cannot write to TC 12 directly — they
          participate via their national standards body.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
