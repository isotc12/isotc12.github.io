---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import { committee } from '../data/committee'
---

<BaseLayout title="Contact" description="How to reach ISO/TC 12 — secretariat held by SIS (Sweden).">
  <div class="page page--medium">
    <PageHero
      eyebrow="Contact"
      title="Reach the committee"
      lead="The secretariat is held by SIS, Sweden. For matters about the committee, contact the committee manager."
    />

    <div class="contact-grid">
      <div class="card">
        <p class="eyebrow">Secretariat</p>
        <h2 class="contact-name">{committee.secretariat}</h2>
        <dl class="contact-dl">
          <div>
            <dt>Committee Manager</dt>
            <dd>{committee.committee_manager}</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${committee.secretariat_email}`} class="contact-email">{committee.secretariat_email}</a></dd>
          </div>
        </dl>
      </div>

      <div class="card">
        <p class="eyebrow">ISO channels</p>
        <ul class="iso-channels">
          <li>
            <a href={committee.links.isoCommittee}>
              <span class="channel-label">ISO committee page ↗</span>
              <span class="channel-desc">Official ISO/TC 12 entry on iso.org</span>
            </a>
          </li>
          <li>
            <a href={committee.links.committeeSite}>
              <span class="channel-label">ISO committee site ↗</span>
              <span class="channel-desc">All committee documents — restricted to member body login</span>
            </a>
          </li>
          <li>
            <a href="https://www.iso.org/meetings.html">
              <span class="channel-label">ISO Meetings ↗</span>
              <span class="channel-desc">Upcoming TC 12 meetings and registration</span>
            </a>
          </li>
        </ul>

        <p class="eyebrow" style="margin-top: 1.5rem;">For ISO member bodies</p>
        <p class="member-note">
          Member bodies conduct formal correspondence through the ISO Global
          Directory. Individuals cannot write to TC 12 directly — they
          participate via their national standards body.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  @media (min-width: 768px) { .contact-grid { grid-template-columns: repeat(2, 1fr); } }
  .contact-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-slate-900);
    margin: 0.625rem 0 1rem;
  }
  .dark .contact-name { color: #fafaf9; }
  .contact-dl { margin: 0; display: flex; flex-direction: column; gap: 0.875rem; }
  .contact-dl dt { font-size: 0.75rem; font-weight: 600; color: var(--color-slate-500); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem; }
  .contact-dl dd { margin: 0; font-size: 0.9375rem; color: var(--color-slate-900); }
  .dark .contact-dl dd { color: #fafaf9; }
  .contact-email { color: var(--color-brand); text-decoration: none; font-family: var(--font-mono); font-size: 0.875rem; }
  .contact-email:hover { text-decoration: underline; }

  .iso-channels { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-direction: column; gap: 0.875rem; }
  .iso-channels a {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #f5f5f4;
    text-decoration: none;
    color: inherit;
  }
  .dark .iso-channels a { border-color: rgb(255 255 255 / 0.04); }
  .iso-channels a:last-child { border-bottom: 0; }
  .channel-label { font-family: var(--font-serif); font-size: 1.0625rem; font-weight: 600; color: var(--color-brand); }
  .channel-desc { font-size: 0.8125rem; color: var(--color-slate-500); }
  .member-note {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-slate-500);
  }
</style>
