---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
---
<BaseLayout title="News — ISO/TC 12" description="News and announcements from ISO/TC 12.">
  <PageHero variant="index" bleed eyebrow="Latest" title="News" lead="Announcements and updates from ISO/TC 12." />
  <div class="page page--wide">
    <section class="empty-section">
      <p class="empty-text">No posts yet. Check back for announcements about new publications, upcoming meetings, and committee news.</p>
    </section>
  </div>
</BaseLayout>
<style>
  .empty-section { max-width: 48rem; margin: 2rem auto; padding: 0 1.5rem; }
  .empty-text { font-size: 1rem; color: var(--ink-muted); line-height: 1.7; font-family: var(--font-display); font-style: italic; }
</style>
