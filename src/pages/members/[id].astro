---
import BaseLayout from '../../layouts/BaseLayout.astro'
import fs from 'node:fs'

export function getStaticPaths() {
  const members = JSON.parse(fs.readFileSync('public/data/members.json', 'utf-8'))
  return members.map((m) => ({ params: { id: m.id }, props: { member: m } }))
}

const { member: m } = Astro.props

function roleLabel(roleId) {
  const map = {
    chair: 'Chair',
    committee_manager: 'Committee Manager',
    secretariat_support: 'Secretariat Support Team',
    tpm: 'ISO Technical Programme Manager',
    member: 'Committee Member',
    liaison_representative: 'Liaison Representative',
  }
  return map[roleId] || roleId
}

function roleAffiliation(r) {
  if (r.nsbody) return `${r.nsbody} (${r.member_type || ''})`
  if (r.organization) return `${r.organization}${r.liaison_type ? ` (${r.liaison_type})` : ''}`
  if (r.committee) return r.committee
  return ''
}

function initials(name) {
  if (!name) return '?'
  const parts = name.replace(/,.*/, '').trim().split(/\s+/)
  return parts.map(p => p[0]).slice(0, 3).join('').toUpperCase()
}
---

<BaseLayout title={`${m.name} — ISO/TC 12`} description={`${m.name}, ${roleLabel(m.roles[0]?.id || 'member')} of ISO/TC 12.`}>
  <article class="page">
    <a href="/members/" class="back-link">← All members</a>

    <header class="member-head">
      <div class="member-head__avatar">
        <span class="member-head__initials">{initials(m.name)}</span>
      </div>
      <div>
        <h1 class="member-head__name">{m.salutation && m.salutation !== '-' ? `${m.salutation} ` : ''}{m.name}</h1>
        <p class="member-head__role">{roleLabel(m.roles[0]?.id || 'member')}</p>
      </div>
    </header>

    <div class="member-detail-grid">
      <aside>
        <dl class="member-meta">
          {m.email && (
            <div><dt>Email</dt><dd><a href={`mailto:${m.email}`} class="text-link">{m.email}</a></dd></div>
          )}
          <div><dt>Status</dt><dd>{m.active ? 'Active' : 'Inactive'}</dd></div>
        </dl>
      </aside>

      <section>
        <p class="eyebrow">Roles in ISO/TC 12</p>
        <ul class="roles-list">
          {m.roles.map((r) => (
            <li class="role-item">
              <span class="role-item__label">{roleLabel(r.id)}</span>
              {roleAffiliation(r) && <span class="role-item__aff">{roleAffiliation(r)}</span>}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .back-link { display: inline-block; font-size: 0.8125rem; color: var(--ink-muted); text-decoration: none; margin-bottom: 2rem; font-family: var(--font-mono); }
  .back-link:hover { color: var(--accent); }

  .member-head { display: flex; gap: 1.5rem; align-items: center; padding-bottom: 2rem; border-bottom: 1px solid var(--rule-strong); margin-bottom: 3rem; }
  .member-head__avatar { width: 4rem; height: 4rem; border-radius: 999px; background: var(--bg-elevated); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; color: var(--accent); flex-shrink: 0; }
  .member-head__name { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 500; color: var(--ink); margin: 0; letter-spacing: -0.02em; line-height: 1.15; }
  .member-head__role { margin: 0.5rem 0 0; font-size: 1rem; color: var(--accent); font-weight: 500; }

  .member-detail-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 1024px) { .member-detail-grid { grid-template-columns: 1fr 2fr; gap: 3rem; } }

  .member-meta { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .member-meta dt { font-size: 0.6875rem; font-weight: 600; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.375rem; }
  .member-meta dd { margin: 0; font-size: 0.9375rem; color: var(--ink); }

  .roles-list { list-style: none; padding: 0; margin: 1rem 0 0; }
  .role-item { display: grid; grid-template-columns: 14rem 1fr; gap: 1rem; padding: 0.875rem 0; border-bottom: 1px solid var(--rule); }
  @media (max-width: 640px) { .role-item { grid-template-columns: 1fr; gap: 0.25rem; } }
  .role-item__label { font-weight: 600; color: var(--ink); font-size: 0.9375rem; }
  .role-item__aff { color: var(--ink-muted); font-size: 0.875rem; }

  .text-link { color: var(--accent); text-decoration: none; font-family: var(--font-mono); font-size: 0.875rem; }
  .text-link:hover { text-decoration: underline; }
</style>
