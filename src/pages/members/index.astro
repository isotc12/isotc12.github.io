---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import fs from 'node:fs'

const members = JSON.parse(fs.readFileSync('public/data/members.json', 'utf-8'))

function initials(name) {
  if (!name) return '?'
  const parts = name.replace(/,.*/, '').trim().split(/\s+/)
  return parts.map(p => p[0]).slice(0, 3).join('').toUpperCase()
}

function roleLabel(roleId) {
  const map = {
    chair: 'Chair',
    committee_manager: 'Committee Manager',
    secretariat_support: 'Secretariat Support',
    tpm: 'Technical Programme Manager',
    member: 'Committee Member',
    liaison_representative: 'Liaison Representative',
  }
  return map[roleId] || roleId
}

function primaryRole(m) {
  const priority = ['chair', 'committee_manager', 'secretariat_support', 'tpm', 'liaison_representative', 'member']
  for (const p of priority) {
    const r = m.roles.find(role => role.id === p)
    if (r) return r
  }
  return m.roles[0]
}

function primaryAffiliation(r) {
  if (r.nsbody) return r.nsbody
  if (r.organization) return r.organization
  if (r.committee) return r.committee
  return ''
}

// Sort: leadership first, then by name
const leadershipIds = ['chair', 'committee_manager', 'secretariat_support', 'tpm']
const sorted = [...members].sort((a, b) => {
  const aLeader = a.roles.some(r => leadershipIds.includes(r.id)) ? 0 : 1
  const bLeader = b.roles.some(r => leadershipIds.includes(r.id)) ? 0 : 1
  if (aLeader !== bLeader) return aLeader - bLeader
  return (a.name || '').localeCompare(b.name || '')
})
---

<BaseLayout title="Members — ISO/TC 12" description="The experts of ISO/TC 12.">
  <PageHero
    variant="index"
    bleed
    eyebrow="The committee"
    title="Members"
    lead={`${members.length} experts from national bodies and liaison organisations shaping the ISO 80000 series.`}
  />

  <div class="page page--wide">
    <section class="members-section">
      <header class="members-section__head">
        <h2>All members <span class="count">{members.length}</span></h2>
      </header>
      <ul class="member-grid">
        {sorted.map((m) => {
          const r = primaryRole(m)
          const aff = primaryAffiliation(r)
          return (
            <li>
              <a href={`/members/${m.id}/`} class="member-card">
                <div class="member-card__avatar">
                  <span class="member-card__initials">{initials(m.name)}</span>
                </div>
                <div class="member-card__body">
                  <h3 class="member-card__name">{m.name}</h3>
                  <p class="member-card__role">{roleLabel(r.id)}</p>
                  {aff && <p class="member-card__aff">{aff}</p>}
                </div>
              </a>
            </li>
          )
        })}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .members-section { max-width: 80rem; margin: 2rem auto 3rem; padding: 0 1.5rem; }
  @media (min-width: 1024px) { .members-section { padding: 0 2rem; } }
  .members-section__head { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem; }
  .members-section__head h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: var(--ink); margin: 0; letter-spacing: -0.015em; }
  .count { font-size: 0.875rem; color: var(--ink-muted); margin-left: 0.5rem; font-weight: 400; }

  .member-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  @media (min-width: 640px) { .member-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .member-grid { grid-template-columns: repeat(3, 1fr); } }

  .member-card {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--rule);
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    border-radius: 0.375rem;
    transition: border-color 0.15s, transform 0.15s;
    align-items: center;
  }
  .member-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .member-card__avatar {
    width: 3rem; height: 3rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-size: 0.875rem; font-weight: 600;
    color: var(--accent);
    overflow: hidden;
  }
  .member-card__name { font-family: var(--font-sans); font-size: 0.875rem; font-weight: 600; color: var(--ink); margin: 0; line-height: 1.3; }
  .member-card__role { font-size: 0.75rem; color: var(--accent); margin: 0.125rem 0 0; font-weight: 500; }
  .member-card__aff { font-size: 0.6875rem; color: var(--ink-muted); margin: 0.125rem 0 0; }
</style>
