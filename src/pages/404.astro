---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404 — Not found" description="The page you requested could not be found." noIndex={true}>
  <div class="page page--medium error-page">
    <p class="eyebrow">Error 404</p>
    <h1 class="error-title">Not<br /><span>found.</span></h1>
    <p class="error-lead">
      The page you requested doesn't exist.
    </p>
    <p class="error-actions">
      <a href="/" class="btn-primary">Home →</a>
      <a href="/standards/" class="btn-secondary">ISO 80000 series</a>
      <a href="/decisions/" class="btn-secondary">All resolutions</a>
    </p>
  </div>
</BaseLayout>

<style>
  .error-page { padding-top: 4rem; }
  .error-title {
    font-family: var(--font-serif);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-slate-900);
    margin: 0.75rem 0 0;
  }
  .dark .error-title { color: #fafaf9; }
  .error-title span { color: var(--color-brand); }
  .error-lead {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-slate-600);
    margin: 1.5rem 0 2rem;
    max-width: 36ch;
  }
  .dark .error-lead { color: var(--color-slate-300); }
  .error-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0; }
</style>
