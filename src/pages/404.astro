---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Not found" description="The page you requested could not be found." noIndex={true}>
  <article class="page error">
    <p class="eyebrow eyebrow--ref">Error 404</p>
    <h1 class="error__title">
      Not<br />
      <span class="error__em">found.</span>
    </h1>
    <p class="error__lead">
      The page you requested doesn't exist. The reference is out of range.
    </p>
    <div class="error__actions">
      <a href="/" class="btn btn--ref">Home →</a>
      <a href="/standards/" class="btn btn--ghost">ISO 80000 series</a>
      <a href="/decisions/" class="btn btn--ghost">All resolutions</a>
    </div>
  </article>
</BaseLayout>

<style>
  .error { padding-top: 4rem; max-width: 48rem; }
  .error__title { font-family: var(--font-display); font-size: clamp(4rem, 12vw, 9rem); font-weight: 500; line-height: 0.95; letter-spacing: -0.035em; color: var(--ink); margin: 1.25rem 0 0; }
  .error__em { font-style: italic; color: var(--accent); font-weight: 400; }
  .error__lead { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.5; color: var(--ink-secondary); margin: 1.75rem 0 2rem; max-width: 38ch; }
  .error__actions { display: flex; flex-wrap: wrap; gap: 0.625rem; }
</style>
