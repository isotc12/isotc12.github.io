---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import fs from 'node:fs'

export function getStaticPaths() {
  const nb = JSON.parse(fs.readFileSync('public/data/national_bodies_full.json', 'utf-8'))
  return [
    ...(nb.participating || []),
    ...(nb.observing || []),
  ].map((n) => ({ params: { id: n.id }, props: { nb: n } }))
}

const { nb: m } = Astro.props
const eyebrow = [m.membership === 'P' ? 'P-member' : m.membership === 'O' ? 'O-member' : null, m.country].filter(Boolean).join(' · ')
---

<BaseLayout title={`${m.short_name} — ISO/TC 12`} description={`${m.short_name} (${m.country}) is a ${m.membership}-member of ISO/TC 12.`}>
  <article class="page page--medium">
    <a href="/national-bodies/" class="back-link">← All national bodies</a>

    <header class="nb-detail-head">
      <p class="eyebrow eyebrow--ref">{eyebrow}</p>
      <h1 class="nb-detail-head__title">{m.short_name}</h1>
      {m.country && m.country !== m.short_name && <p class="nb-detail-head__full">{m.country}</p>}
    </header>

    <div class="nb-detail-grid">
      <aside>
        <dl class="nb-meta">
          <div><dt>Short name</dt><dd class="num">{m.short_name}</dd></div>
          {m.country && <div><dt>Country</dt><dd>{m.country}</dd></div>}
          {m.iso_country_code && <div><dt>ISO country code</dt><dd class="num">{m.iso_country_code}</dd></div>}
          <div><dt>Membership</dt><dd>{m.membership === 'P' ? 'P-member (participating)' : 'O-member (observing)'}</dd></div>
          {m.representatives && m.representatives.length > 0 && <div><dt>Representatives</dt><dd>{m.representatives.length}</dd></div>}
        </dl>
      </aside>

      <section>
        <p class="eyebrow">About this body</p>
        <p class="nb-description">
          {m.short_name} is the national standards body of {m.country}, participating
          in ISO/TC 12 work on quantities and units as a {m.membership === 'P' ? 'participating' : 'observing'} member.
        </p>

        {m.representatives && m.representatives.length > 0 && (
          <>
            <p class="eyebrow" style="margin-top: 2rem;">Representatives</p>
            <ul class="nb-rep-list">
              {m.representatives.map((r) => <li>{r}</li>)}
            </ul>
          </>
        )}
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .back-link { display: inline-block; font-size: 0.8125rem; color: var(--ink-muted); text-decoration: none; margin-bottom: 2rem; font-family: var(--font-mono); }
  .back-link:hover { color: var(--accent); }

  .nb-detail-head { padding-bottom: 2rem; border-bottom: 1px solid var(--rule-strong); margin-bottom: 3rem; }
  .nb-detail-head__title { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; letter-spacing: -0.025em; color: var(--ink); margin: 0.75rem 0 0; line-height: 1.05; }
  .nb-detail-head__full { font-family: var(--font-display); font-size: 1.1875rem; line-height: 1.5; color: var(--ink-secondary); margin: 1rem 0 0; }

  .nb-detail-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 1024px) { .nb-detail-grid { grid-template-columns: 1fr 2fr; gap: 3rem; } }

  .nb-meta { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .nb-meta dt { font-size: 0.6875rem; font-weight: 600; color: var(--ink-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.375rem; }
  .nb-meta dd { margin: 0; font-size: 0.9375rem; color: var(--ink); }
  .num { font-family: var(--font-mono); }

  .nb-description { font-family: var(--font-display); font-size: 1.0625rem; line-height: 1.6; color: var(--ink-secondary); margin: 0.75rem 0 0; }

  .nb-rep-list { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-direction: column; gap: 0.375rem; }
  .nb-rep-list li { font-size: 0.9375rem; color: var(--ink); padding: 0.375rem 0; border-bottom: 1px solid var(--rule); }
</style>
