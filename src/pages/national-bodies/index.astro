---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import fs from 'node:fs'

const nb = JSON.parse(fs.readFileSync('public/data/national_bodies_full.json', 'utf-8'))
const pMembers = [...(nb.participating || [])].sort((a, b) => (a.country || a.short_name).localeCompare(b.country || b.short_name))
const oMembers = [...(nb.observing || [])].sort((a, b) => (a.country || a.short_name).localeCompare(b.country || b.short_name))
---

<BaseLayout title="National bodies — ISO/TC 12" description="Participating and observing member bodies of ISO/TC 12.">
  <PageHero
    variant="index"
    bleed
    eyebrow="The committee"
    title="National bodies"
    lead={`${pMembers.length} participating (P-members) and ${oMembers.length} observing (O-members) national standards bodies.`}
  />

  <div class="page page--wide">
    {pMembers.length > 0 && (
      <section class="nb-section">
        <header class="nb-section__head">
          <h2>Participating members (P) <span class="count">{pMembers.length}</span></h2>
        </header>
        <ul class="nb-grid">
          {pMembers.map((m) => (
            <li>
              <a href={`/national-bodies/${m.id}/`} class="nb-card">
                <span class="nb-card__code">{m.iso_country_code}</span>
                <div class="nb-card__body">
                  <h3 class="nb-card__name">{m.short_name}</h3>
                  <p class="nb-card__body-id">{m.country}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {oMembers.length > 0 && (
      <section class="nb-section">
        <header class="nb-section__head">
          <h2>Observing members (O) <span class="count">{oMembers.length}</span></h2>
        </header>
        <ul class="nb-grid">
          {oMembers.map((m) => (
            <li>
              <a href={`/national-bodies/${m.id}/`} class="nb-card nb-card--observing">
                <span class="nb-card__code">{m.iso_country_code}</span>
                <div class="nb-card__body">
                  <h3 class="nb-card__name">{m.short_name}</h3>
                  <p class="nb-card__body-id">{m.country}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="nb-section">
      <header class="nb-section__head"><h2>P vs O membership</h2></header>
      <div class="nb-prose">
        <p><strong>P-members</strong> (participating) vote on every formal question — new work items, enquiry drafts, final drafts, and resolutions — and are expected to nominate experts to working groups.</p>
        <p><strong>O-members</strong> (observers) follow the work, receive documents, and may submit comments, but do not vote.</p>
        <p><a href="https://www.iso.org/members.html" class="text-link">Find your ISO member body ↗</a></p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .nb-section { max-width: 80rem; margin: 2rem auto 3rem; padding: 0 1.5rem; }
  @media (min-width: 1024px) { .nb-section { padding: 0 2rem; } }
  .nb-section__head { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem; }
  .nb-section__head h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: var(--ink); margin: 0; letter-spacing: -0.015em; }
  .count { font-size: 0.875rem; color: var(--ink-muted); margin-left: 0.5rem; font-weight: 400; }

  .nb-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 0.5rem; }
  @media (min-width: 768px) { .nb-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .nb-grid { grid-template-columns: repeat(3, 1fr); } }

  .nb-card { display: grid; grid-template-columns: 3rem 1fr; gap: 0.75rem; padding: 0.75rem 1rem; border: 1px solid var(--rule); background: var(--bg); border-radius: 0.375rem; align-items: center; transition: border-color 0.15s, transform 0.15s; text-decoration: none; color: inherit; }
  .nb-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .nb-card--observing { opacity: 0.7; }
  .nb-card__code { font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--accent); text-align: center; }
  .nb-card__name { font-size: 0.875rem; font-weight: 500; color: var(--ink); margin: 0; }
  .nb-card__body-id { font-size: 0.6875rem; color: var(--ink-muted); margin: 0.125rem 0 0; font-family: var(--font-mono); text-transform: uppercase; }

  .nb-prose { max-width: 42rem; font-size: 0.9375rem; line-height: 1.7; color: var(--ink-secondary); }
  .nb-prose strong { color: var(--ink); font-weight: 600; }
  .text-link { color: var(--accent); text-decoration: none; font-weight: 500; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
