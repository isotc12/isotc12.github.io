---
import BaseLayout from '../../layouts/BaseLayout.astro'
import fs from 'node:fs'

export function getStaticPaths() {
  const standards = JSON.parse(fs.readFileSync('public/data/standards.json', 'utf-8'))
  return standards.map((s) => ({ params: { slug: s.slug }, props: { standard: s } }))
}

const { standard } = Astro.props

const statusLabel = (s) => {
  if (s === 'published') return 'Published'
  if (s === 'under development') return 'Under development'
  if (s === 'under revision') return 'Under revision'
  if (s === 'withdrawn') return 'Withdrawn'
  return s
}

const stageLabel = (stage) => {
  const map = {
    '10.99': '10.99 — New project approved',
    '20.00': '20.00 — New work item registered',
    '30.00': '30.00 — Committee draft (CD) initiated',
    '30.60': '30.60 — CD close to registration',
    '50.00': '50.00 — FDIS registered',
    '60.00': '60.00 — IS published',
    '90.20': '90.20 — Systematic review due',
    '95.99': '95.99 — Withdrawn',
  }
  return map[stage] || stage
}

const isIEC = standard.part >= 14 && standard.part <= 17
const orgPrefix = isIEC ? 'IEC' : 'ISO'
const fullRef = `${orgPrefix} ${isIEC ? 'IEC ' : ''}80000-${standard.part}`
---

<BaseLayout
  title={`${orgPrefix} 80000-${standard.part} — ${standard.title}`}
  description={`${fullRef}: ${standard.title}. ${standard.scope}`}
>
  <article class="spec-sheet">
    <header class="max-w-[1320px] mx-auto px-6 lg:px-10 pt-10">
      <a href="/standards/" class="font-mono text-xs text-muted hover:text-ink">← All parts</a>
    </header>

    <div class="max-w-[1320px] mx-auto px-6 lg:px-10 mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-end anim-fade-up">
      <div class="lg:col-span-8">
        <div class="font-mono text-[0.7rem] tracking-[0.18em] text-wine uppercase mb-3">
          {orgPrefix}/IEC 80000 · Part {standard.part}
        </div>
        <h1 class="font-display font-medium leading-[1.05] tracking-[-0.02em] text-[var(--text-h1)] text-balance">
          {standard.title}
        </h1>
        <p class="lede mt-6 max-w-2xl">{standard.scope}</p>
      </div>

      <aside class="lg:col-span-4 lg:border-l lg:border-rule lg:pl-10 self-end">
        <dl class="space-y-5">
          <div class="grid grid-cols-12 gap-3 items-baseline">
            <dt class="col-span-4 eyebrow">Reference</dt>
            <dd class="col-span-8 font-mono text-base">{fullRef}</dd>
          </div>
          {standard.edition_year && (
            <div class="grid grid-cols-12 gap-3 items-baseline">
              <dt class="col-span-4 eyebrow">Edition</dt>
              <dd class="col-span-8 font-mono text-base tabular-nums">{standard.edition_year}</dd>
            </div>
          )}
          <div class="grid grid-cols-12 gap-3 items-baseline">
            <dt class="col-span-4 eyebrow">Stage</dt>
            <dd class="col-span-8 font-mono text-xs">{stageLabel(standard.stage)}</dd>
          </div>
          <div class="grid grid-cols-12 gap-3 items-baseline">
            <dt class="col-span-4 eyebrow">Status</dt>
            <dd class="col-span-8">
              <span class:list={[
                'inline-flex items-baseline gap-1.5 text-xs font-mono px-2 py-0.5',
                standard.status === 'published' && 'text-calibration bg-calibration/10',
                (standard.status === 'under development' || standard.status === 'under revision') && 'text-wine bg-wine/10',
                standard.status === 'withdrawn' && 'text-muted bg-muted/10 line-through',
              ]}>{statusLabel(standard.status)}</span>
            </dd>
          </div>
        </dl>
      </aside>
    </div>

    <section class="max-w-[1320px] mx-auto px-6 lg:px-10 mt-24">
      <div class="hairline pt-8 grid grid-cols-1 md:grid-cols-12 gap-x-12 gap-y-10">
        <div class="md:col-span-3">
          <div class="eyebrow">In the series</div>
        </div>
        <div class="md:col-span-9 prose-tc12 max-w-none">
          <p>
            Part {standard.part} of the ISO/IEC 80000 series. The series
            defines names, symbols, and units of quantities used across
            science, technology, and trade. Each part covers a single domain.
          </p>
          {isIEC && (
            <p>
              Developed jointly with <strong class="text-ink">IEC/TC 25</strong>
              under joint working group <strong class="text-ink">JWG 2</strong>.
            </p>
          )}
          {standard.status === 'under revision' && (
            <p>
              A revision is currently in progress, coordinated through
              ISO/TC 12 working groups.
            </p>
          )}
        </div>
      </div>
    </section>

    <section class="max-w-[1320px] mx-auto px-6 lg:px-10 mt-20">
      <div class="hairline pt-8 grid grid-cols-1 md:grid-cols-12 gap-x-12 gap-y-10">
        <div class="md:col-span-3">
          <div class="eyebrow">Recent activity</div>
        </div>
        <div class="md:col-span-9 prose-tc12 max-w-none">
          <p>
            The committee most recently addressed this part at the
            <a href="/decisions/" class="text-wine">23rd plenary meeting (May 2026)</a>,
            which covered systematic reviews, stability dates, and SMART
            exploration for the ISO/IEC 80000 series as a whole.
          </p>
          <a href="/decisions/" class="font-mono text-sm text-wine hover:text-wine-deep border-b border-wine pb-0.5 inline-block mt-2">
            See all resolutions →
          </a>
        </div>
      </div>
    </section>

    <section class="max-w-[1320px] mx-auto px-6 lg:px-10 mt-20">
      <div class="hairline pt-8 grid grid-cols-1 md:grid-cols-12 gap-x-12 gap-y-4">
        <div class="md:col-span-3">
          <div class="eyebrow">External</div>
        </div>
        <div class="md:col-span-9">
          <ul class="space-y-2 text-sm">
            <li>
              <a href={`https://www.iso.org/standard.html`} class="text-ink hover:text-wine">
                <span class="font-mono text-wine">{fullRef}</span> on the ISO Store ↗
              </a>
            </li>
            <li>
              <a href="https://www.bipm.org/en/measurement-units/si-brochure" class="text-ink hover:text-wine">
                <span class="font-mono text-muted">BIPM SI Brochure</span> — the foundational reference for all ISO 80000 quantities ↗
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
