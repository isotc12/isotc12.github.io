---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import UnitGrid from '../../components/UnitGrid.astro'
import fs from 'node:fs'

const standards = JSON.parse(fs.readFileSync('public/data/standards.json', 'utf-8'))
const sorted = [...standards].sort((a, b) => a.part - b.part)
---

<BaseLayout title="Standards" description="The ISO/IEC 80000 series — quantities and units across all domains of science and technology.">
  <div class="page page--wide">
    <PageHero
      eyebrow="The series"
      title="ISO/IEC 80000 — Quantities and units"
      lead="Fifteen parts. One series. Every quantity used in measurement science — space, time, mechanics, light, sound, chemistry, atoms, information."
    />

    <section class="standards-section">
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Part</th>
              <th>Title</th>
              <th class="hide-mobile">Edition</th>
              <th class="hide-mobile">Stage</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((s) => (
              <tr>
                <td><a href={`/standards/${s.slug}/`} class="ref-link">{`80000-${String(s.part).padStart(2, '0')}`}</a></td>
                <td>
                  <a href={`/standards/${s.slug}/`} class="title-link">
                    <span class="title-text">{s.title}</span>
                    <span class="scope-text">{s.scope}</span>
                  </a>
                </td>
                <td class="hide-mobile mono">{s.edition_year ?? '—'}</td>
                <td class="hide-mobile mono muted">{s.stage}</td>
                <td>
                  <span class:list={['status-pill', `status-pill--${s.status === 'published' ? 'published' : s.status === 'withdrawn' ? 'withdrawn' : 'development'}`]}>
                    <span class="status-pill__dot"></span>{s.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="why-section">
      <div class="why-grid">
        <div>
          <p class="eyebrow">Why fifteen parts</p>
          <h2 class="why-title">Organised by domain</h2>
        </div>
        <div class="prose-tc">
          <p>
            The series is partitioned by physical domain. Part 1 (General)
            defines the framework — names, symbols, prefixes, the SI. Parts 2
            through 13 cover specific domains. Parts 14–17 are IEC-led
            (telebiometrics, logarithmic quantities, printing rules,
            time-dependency).
          </p>
          <p>
            The seven SI base units span parts 3–9. Each quantity in the
            series is assigned a dimensional symbol following ISO 80000-1
            conventions.
          </p>
        </div>
        <div class="why-units"><UnitGrid variant="compact" /></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .standards-section { margin-top: 2rem; }
  .data-table-wrap { overflow-x: auto; }
  .data-table td { vertical-align: top; }
  .ref-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-brand);
    text-decoration: none;
  }
  .ref-link:hover { text-decoration: underline; }
  .title-link { text-decoration: none; color: inherit; display: block; }
  .title-text { display: block; font-family: var(--font-serif); font-size: 1rem; font-weight: 600; color: var(--color-slate-900); }
  .dark .title-text { color: #fafaf9; }
  .title-link:hover .title-text { color: var(--color-brand); }
  .scope-text { display: block; font-size: 0.8125rem; color: var(--color-slate-500); margin-top: 0.25rem; line-height: 1.4; }
  .mono { font-family: var(--font-mono); font-size: 0.8125rem; }
  .muted { color: var(--color-slate-500); }

  @media (max-width: 767px) { .hide-mobile { display: none; } }

  .why-section { margin-top: 4rem; padding-top: 2.5rem; border-top: 1px solid #e7e5e4; }
  .dark .why-section { border-color: rgb(255 255 255 / 0.08); }
  .why-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 1024px) { .why-grid { grid-template-columns: 1fr 1.5fr 1fr; gap: 3rem; } }
  .why-title {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 600;
    color: var(--color-slate-900);
    margin: 0.5rem 0 0;
  }
  .dark .why-title { color: #fafaf9; }
</style>
