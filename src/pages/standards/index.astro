---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import fs from 'node:fs'

const standards = JSON.parse(fs.readFileSync('public/data/standards.json', 'utf-8'))
const sorted = [...standards].sort((a, b) => a.part - b.part)
const pillClass = (s) => s === 'published' ? 'published' : s === 'withdrawn' ? 'withdrawn' : 'development'
---

<BaseLayout title="Standards" description="The ISO/IEC 80000 series — quantities and units across all domains of science and technology.">
  <article class="page">
    <PageHero
      eyebrow="The series"
      title="ISO/IEC 80000 — Quantities and units"
      lead="Fifteen parts. One series. Every quantity used in measurement science — space, time, mechanics, light, sound, chemistry, atoms, information."
    />

    <section class="std-section">
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 7rem">Part</th>
              <th>Title</th>
              <th class="hide-mobile">Edition</th>
              <th class="hide-mobile">Stage</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((s) => (
              <tr>
                <td class="num-cell"><a href={`/standards/${s.slug}/`} class="ref-link">{`80000-${String(s.part).padStart(2, '0')}`}</a></td>
                <td>
                  <a href={`/standards/${s.slug}/`} class="title-link">
                    <span class="title-text">{s.title}</span>
                    <span class="scope-text">{s.scope}</span>
                  </a>
                </td>
                <td class="num-cell hide-mobile">{s.edition_year ?? '—'}</td>
                <td class="num-cell hide-mobile muted">{s.stage}</td>
                <td>
                  <span class:list={['pill', `pill--${pillClass(s.status)}`]}>
                    <span class="pill__dot"></span>{s.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="why">
      <div class="why-grid">
        <div>
          <p class="eyebrow">Why fifteen parts</p>
          <h2 class="display-h2">Organised by domain</h2>
        </div>
        <div class="prose-ref">
          <p>
            The series is partitioned by physical domain. Part 1 (General) sets the framework — names, symbols, prefixes, the SI. Parts 2 through 13 cover specific domains. Parts 14–17 are IEC-led (telebiometrics, logarithmic quantities, printing rules, time-dependency).
          </p>
          <p>
            The seven SI base units span parts 3–9. Each quantity in the series carries a dimensional symbol following ISO 80000-1 conventions.
          </p>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .std-section { margin-top: 2.5rem; }
  .data-table-wrap { overflow-x: auto; border: 1px solid var(--rule); border-radius: 0.5rem; }
  .data-table .num-cell { font-family: var(--font-mono); font-size: 0.875rem; color: var(--ink); white-space: nowrap; }
  .ref-link { color: var(--accent); text-decoration: none; font-weight: 500; }
  .ref-link:hover { text-decoration: underline; text-underline-offset: 2px; }
  .title-link { text-decoration: none; color: inherit; display: block; }
  .title-text { display: block; font-family: var(--font-display); font-size: 1.0625rem; font-weight: 500; color: var(--ink); letter-spacing: -0.015em; }
  .title-link:hover .title-text { color: var(--accent); }
  .scope-text { display: block; font-size: 0.8125rem; color: var(--ink-muted); margin-top: 0.375rem; line-height: 1.5; }
  .muted { color: var(--ink-muted) !important; }

  @media (max-width: 767px) { .hide-mobile { display: none; } }

  .why { margin-top: 5rem; padding-top: 3rem; border-top: 1px solid var(--rule-strong); }
  .why-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 1024px) { .why-grid { grid-template-columns: 1fr 1.5fr; gap: 3rem; } }
  .display-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    font-weight: 500;
    color: var(--ink);
    margin: 0.625rem 0 0;
    letter-spacing: -0.02em;
  }
</style>
