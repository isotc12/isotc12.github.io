---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import fs from 'node:fs'

const standards = JSON.parse(fs.readFileSync('public/data/standards.json', 'utf-8'))
const byStatus = { published: [], revision: [], development: [], withdrawn: [] }
for (const s of standards) {
  if (s.status === 'published') byStatus.published.push(s)
  else if (s.status === 'under revision') byStatus.revision.push(s)
  else if (s.status === 'under development') byStatus.development.push(s)
  else if (s.status === 'withdrawn') byStatus.withdrawn.push(s)
}
const published = [...byStatus.published].sort((a, b) => a.part - b.part)
const revision = [...byStatus.revision].sort((a, b) => a.part - b.part)
const development = [...byStatus.development].sort((a, b) => a.part - b.part)
const withdrawn = [...byStatus.withdrawn].sort((a, b) => a.part - b.part)

const pubCount = published.length
const revCount = revision.length
const devCount = development.length
const witCount = withdrawn.length
const isIEC = (p) => p >= 14 && p <= 17
---

<BaseLayout title="Standards — ISO/TC 12" description="The standards catalogue of ISO/TC 12.">
  <PageHero
    variant="index"
    bleed
    eyebrow="Our work"
    title="Standards"
    lead={`${pubCount} published · ${revCount + devCount} under development · ${witCount} withdrawn. The ISO/IEC 80000 series — quantities and units for science, technology, and trade.`}
  />

  <div class="page page--wide">
    <section class="std-section">
      <header class="std-section__head">
        <h2>Published <span class="count">{pubCount}</span></h2>
      </header>
      <ul class="std-list">
        {published.map((s) => (
          <li>
            <a href={`/standards/${s.slug}/`} class="std-card">
              <span class="std-card__num">{`ISO ${isIEC(s.part) ? 'IEC ' : ''}80000-${s.part}`}</span>
              <div class="std-card__body">
                <h3 class="std-card__title">{s.title}</h3>
                <div class="std-card__meta">
                  {s.edition_year && <span>{s.edition_year}</span>}
                  <span>{s.scope}</span>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {(revision.length > 0 || development.length > 0) && (
      <section class="std-section">
        <header class="std-section__head">
          <h2>Under development <span class="count">{revCount + devCount}</span></h2>
        </header>
        <ul class="std-list">
          {[...revision, ...development].map((s) => (
            <li>
              <a href={`/standards/${s.slug}/`} class="std-card std-card--dev">
                <span class="std-card__num">{`ISO ${isIEC(s.part) ? 'IEC ' : ''}80000-${s.part}`}</span>
                <div class="std-card__body">
                  <h3 class="std-card__title">{s.title}</h3>
                  <div class="std-card__meta">
                    <span>stage {s.stage}</span>
                    <span>{s.status}</span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {withdrawn.length > 0 && (
      <section class="std-section">
        <header class="std-section__head">
          <h2>Withdrawn <span class="count">{witCount}</span></h2>
        </header>
        <ul class="std-list">
          {withdrawn.map((s) => (
            <li>
              <a href={`/standards/${s.slug}/`} class="std-card std-card--withdrawn">
                <span class="std-card__num">{`ISO ${isIEC(s.part) ? 'IEC ' : ''}80000-${s.part}`}</span>
                <div class="std-card__body">
                  <h3 class="std-card__title">{s.title}</h3>
                  <div class="std-card__meta">
                    <span>{s.scope}</span>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .std-section { max-width: 80rem; margin: 2rem auto 3rem; padding: 0 1.5rem; }
  @media (min-width: 1024px) { .std-section { padding: 0 2rem; } }
  .std-section__head { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem; }
  .std-section__head h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: var(--ink); margin: 0; letter-spacing: -0.015em; }
  .count { font-size: 0.875rem; color: var(--ink-muted); margin-left: 0.5rem; font-weight: 400; }

  .std-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 0.5rem; }
  @media (min-width: 768px) { .std-list { grid-template-columns: repeat(2, 1fr); } }

  .std-card {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--rule);
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
    align-items: baseline;
    border-radius: 0.375rem;
  }
  .std-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .std-card--withdrawn { opacity: 0.65; }
  .std-card--dev { border-left: 3px solid var(--color-development); }
  .std-card__num {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }
  .std-card__title {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
    line-height: 1.4;
  }
  .std-card__meta {
    margin-top: 0.375rem;
    display: flex; gap: 0.875rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
</style>
