---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import fs from 'node:fs'

const events = JSON.parse(fs.readFileSync('public/data/events.json', 'utf-8'))
---

<BaseLayout title="History — ISO/TC 12" description="Plenary meetings of ISO/TC 12 since 2010.">
  <PageHero
    variant="index"
    bleed
    eyebrow="Timeline"
    title="History"
    lead={`Fifteen plenary meetings since 2010 — from Prague to Zoom.`}
  />

  <div class="page page--wide">
    <section class="hist-section">
      <header class="hist-section__head">
        <h2>Plenary meetings <span class="count">{events.length}</span></h2>
      </header>
      <ol class="hist-list">
        {events.map((e) => (
          <li>
            <a href={`/meetings/plenary-${e.ordinal}/`} class="hist-card">
              <span class="hist-card__num">{e.ordinal}</span>
              <div class="hist-card__body">
                <h3 class="hist-card__title">{e.title}</h3>
                <div class="hist-card__meta">
                  <span>{new Date(e.time?.from?.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                  <span>{e.general_area}</span>
                  {e.host && <span>{e.host}</span>}
                </div>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .hist-section { max-width: 80rem; margin: 2rem auto 3rem; padding: 0 1.5rem; }
  @media (min-width: 1024px) { .hist-section { padding: 0 2rem; } }
  .hist-section__head { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem; }
  .hist-section__head h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: var(--ink); margin: 0; letter-spacing: -0.015em; }
  .count { font-size: 0.875rem; color: var(--ink-muted); margin-left: 0.5rem; font-weight: 400; }

  .hist-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 0.5rem; }
  @media (min-width: 768px) { .hist-list { grid-template-columns: repeat(2, 1fr); } }

  .hist-card {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--rule);
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    border-radius: 0.375rem;
    transition: border-color 0.15s, transform 0.15s;
    align-items: baseline;
  }
  .hist-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .hist-card__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hist-card__title { font-family: var(--font-sans); font-size: 0.9375rem; font-weight: 500; color: var(--ink); margin: 0; line-height: 1.4; }
  .hist-card__meta { margin-top: 0.375rem; display: flex; gap: 0.875rem; font-size: 0.75rem; color: var(--ink-muted); flex-wrap: wrap; }
</style>
