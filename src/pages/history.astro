---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import fs from 'node:fs'

const events = JSON.parse(fs.readFileSync('public/data/events.json', 'utf-8'))

const byYear = new Map()
for (const e of events) {
  const year = e.time?.from?.date?.slice(0, 4) || String(e.year)
  if (!byYear.has(year)) byYear.set(year, [])
  byYear.get(year).push(e)
}
const years = Array.from(byYear.keys()).sort((a, b) => b.localeCompare(a))

function ordinal(n) {
  const s = ['th', 'st', 'nd', 'rd']
  const v = n % 100
  return n + (s[(v - 20) % 10] || s[v] || s[0])
}
---

<BaseLayout title="History" description="Fifteen plenary meetings of ISO/TC 12 from 2010 to 2026 — Prague to Zoom.">
  <div class="page page--wide">
    <PageHero
      eyebrow="History"
      title="From Prague to Zoom"
      lead="Fifteen plenary meetings across sixteen years — from an in-person meeting in Prague (2010) through hybrid meetings in Berlin, Stockholm, and Helsinki, to the virtual Zoom plenaries of the pandemic years."
    />

    <div class="history-grid">
      <aside class="history-nav">
        <p class="eyebrow">Jump to year</p>
        <ol>
          {years.map((y) => (
            <li>
              <a href={`#year-${y}`}>
                <span>{y}</span>
                <span class="count">{byYear.get(y).length}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>

      <div class="history-timeline">
        {years.map((year) => (
          <section id={`year-${year}`} class="year-section">
            <header class="year-header">
              <span class="year-header__num">{year}</span>
              <span class="year-header__count">{byYear.get(year).length} {byYear.get(year).length === 1 ? 'meeting' : 'meetings'}</span>
            </header>
            <ol>
              {byYear.get(year).map((e) => (
                <li class="meeting">
                  <div class="meeting__ordinal">
                    <span class="meeting__num">{e.ordinal}</span>
                    <span class="meeting__date">{new Date(e.time?.from?.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</span>
                  </div>
                  <div class="meeting__body">
                    <h3 class="meeting__title"><a href={e.landing_url}>{e.title}</a></h3>
                    <p class="meeting__meta">{e.general_area}{e.host && <> · hosted by {e.host}</>}</p>
                    {e.acting_chair_at_meeting && (
                      <p class="meeting__note">Acting chair: {e.acting_chair_at_meeting}</p>
                    )}
                    {e.attendance?.countries && (
                      <ul class="meeting__countries">
                        {e.attendance.countries.filter((c) => c.attended !== false).map((c) => (
                          <li>{c.code}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .history-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) {
    .history-grid { grid-template-columns: 220px 1fr; gap: 3rem; }
  }

  .history-nav { position: sticky; top: 6rem; align-self: start; }
  .history-nav ol { list-style: none; padding: 0; margin: 0.75rem 0 0; }
  .history-nav li { border-bottom: 1px solid #f5f5f4; }
  .dark .history-nav li { border-color: rgb(255 255 255 / 0.04); }
  .history-nav a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.625rem 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-slate-600);
    text-decoration: none;
    transition: color 0.15s;
  }
  .dark .history-nav a { color: var(--color-slate-300); }
  .history-nav a:hover { color: var(--color-brand); }
  .history-nav .count { font-size: 0.75rem; color: var(--color-slate-400); }

  .year-section { margin-bottom: 3rem; }
  .year-header {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    padding: 1rem 0;
    border-bottom: 1px solid #e7e5e4;
    margin-bottom: 0.5rem;
  }
  .dark .year-header { border-color: rgb(255 255 255 / 0.08); }
  .year-header__num {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--color-brand);
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .year-header__count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-slate-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .year-section ol { list-style: none; padding: 0; margin: 0; }
  .meeting {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid #f5f5f4;
  }
  .dark .meeting { border-color: rgb(255 255 255 / 0.04); }
  @media (min-width: 768px) { .meeting { grid-template-columns: 8rem 1fr; gap: 2rem; } }

  .meeting__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand);
  }
  .meeting__date {
    display: block;
    font-size: 0.75rem;
    color: var(--color-slate-500);
    margin-top: 0.25rem;
  }

  .meeting__title { font-family: var(--font-serif); font-size: 1.1875rem; font-weight: 600; margin: 0; }
  .meeting__title a { color: var(--color-slate-900); text-decoration: none; }
  .dark .meeting__title a { color: #fafaf9; }
  .meeting__title a:hover { color: var(--color-brand); }
  .meeting__meta { margin: 0.375rem 0 0; font-size: 0.875rem; color: var(--color-slate-500); }
  .meeting__note { margin: 0.25rem 0 0; font-size: 0.8125rem; font-style: italic; color: var(--color-slate-500); }

  .meeting__countries {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .meeting__countries li {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 0.125rem 0.4375rem;
    border: 1px solid #e7e5e4;
    border-radius: 0.25rem;
    color: var(--color-slate-600);
  }
  .dark .meeting__countries li {
    border-color: rgb(255 255 255 / 0.1);
    color: var(--color-slate-300);
  }
</style>
