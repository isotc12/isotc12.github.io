---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import fs from 'node:fs'

const data = JSON.parse(fs.readFileSync('public/data/liaisons.json', 'utf-8'))
const slugify = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')

const external = (data.external_organisations || []).map((l) => ({ ...l, id: slugify(l.short_name) })).sort((a, b) => a.short_name.localeCompare(b.short_name))
const committees = (data.iso_iec_committees || []).map((l) => ({ ...l, id: slugify(l.ref) })).sort((a, b) => a.ref.localeCompare(b.ref))
---

<BaseLayout title="Liaisons — ISO/TC 12" description="Liaison organisations and committees of ISO/TC 12.">
  <PageHero
    variant="index"
    bleed
    eyebrow="External relationships"
    title="Liaisons"
    lead={`${external.length + committees.length} ISO/IEC committees and external organisations in liaison with ISO/TC 12.`}
  />

  <div class="page page--wide">
    {external.length > 0 && (
      <section class="lia-section">
        <header class="lia-section__head">
          <h2>External organisations <span class="count">{external.length}</span></h2>
        </header>
        <ul class="lia-grid">
          {external.map((l) => (
            <li>
              <a href={`/liaisons/${l.id}/`} class="lia-card">
                <h3 class="lia-card__name">{l.short_name}</h3>
                {l.category && <span class="lia-card__type">Category {l.category}</span>}
                {l.name && <p class="lia-card__full">{l.name}</p>}
                {l.representatives && l.representatives.length > 0 && (
                  <p class="lia-card__rep">{l.representatives.slice(0, 3).join(', ')}{l.representatives.length > 3 ? ` +${l.representatives.length - 3} more` : ''}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {committees.length > 0 && (
      <section class="lia-section">
        <header class="lia-section__head">
          <h2>ISO/IEC committees <span class="count">{committees.length}</span></h2>
        </header>
        <ul class="lia-grid">
          {committees.map((l) => (
            <li>
              <a href={`/liaisons/${encodeURIComponent(l.id.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, ''))}/`} class="lia-card lia-card--committee">
                <h3 class="lia-card__name">{l.ref}</h3>
                <p class="lia-card__full">ISO/IEC committee</p>
                {l.representatives && l.representatives.length > 0 && (
                  <p class="lia-card__rep">{l.representatives.slice(0, 3).join(', ')}{l.representatives.length > 3 ? ` +${l.representatives.length - 3} more` : ''}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .lia-section { max-width: 80rem; margin: 2rem auto 3rem; padding: 0 1.5rem; }
  @media (min-width: 1024px) { .lia-section { padding: 0 2rem; } }
  .lia-section__head { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem; }
  .lia-section__head h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: var(--ink); margin: 0; letter-spacing: -0.015em; }
  .count { font-size: 0.875rem; color: var(--ink-muted); margin-left: 0.5rem; font-weight: 400; }

  .lia-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  @media (min-width: 768px) { .lia-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .lia-grid { grid-template-columns: repeat(3, 1fr); } }

  .lia-card { display: block; padding: 1rem 1.25rem; border: 1px solid var(--rule); background: var(--bg); border-radius: 0.375rem; transition: border-color 0.15s, transform 0.15s; text-decoration: none; color: inherit; }
  .lia-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .lia-card--committee { border-left: 3px solid var(--accent); }
  .lia-card__name { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--accent); margin: 0 0 0.25rem; }
  .lia-card__type { display: inline-block; font-size: 0.6875rem; font-weight: 600; color: var(--ink-muted); background: var(--bg-elevated); padding: 0.125rem 0.4375rem; border-radius: 0.25rem; margin-bottom: 0.375rem; }
  .lia-card__full { font-size: 0.875rem; color: var(--ink-secondary); margin: 0; line-height: 1.4; }
  .lia-card__rep { font-size: 0.75rem; color: var(--ink-muted); margin: 0.375rem 0 0; line-height: 1.4; }
</style>
