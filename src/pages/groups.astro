---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import fs from 'node:fs'

const groups = JSON.parse(fs.readFileSync('public/data/groups.json', 'utf-8'))
const active = groups.filter((g) => g.status === 'active' || g.status === 'transition')
const disbanded = groups.filter((g) => g.status === 'disbanded')
---

<BaseLayout title="Groups — ISO/TC 12" description="Working groups and structures of ISO/TC 12.">
  <PageHero
    variant="index"
    bleed
    eyebrow="Committee structure"
    title="Groups"
    lead={`${active.length} active groups — working groups driving today's programmes, plus disbanded groups whose work is complete.`}
  />

  <div class="page page--wide">
    {active.length > 0 && (
      <section class="grp-section">
        <header class="grp-section__head">
          <h2>Working Groups <span class="count">{active.length}</span></h2>
        </header>
        <ul class="grp-grid">
          {active.map((g) => (
            <li>
              <a href={g.href} class="grp-card">
                <span class="grp-card__id">{g.name}</span>
                <h3 class="grp-card__title">{g.scope}</h3>
                {g.convenor && <p class="grp-card__convenor">Convenor: {g.convenor}</p>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {disbanded.length > 0 && (
      <section class="grp-section">
        <header class="grp-section__head">
          <h2>Disbanded <span class="count">{disbanded.length}</span></h2>
        </header>
        <ul class="grp-grid">
          {disbanded.map((g) => (
            <li>
              <div class="grp-card grp-card--disbanded">
                <span class="grp-card__id">{g.name}</span>
                <h3 class="grp-card__title">{g.scope}</h3>
                {g.disbanded && <p class="grp-card__convenor">Disbanded: {g.disbanded}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .grp-section { max-width: 80rem; margin: 2rem auto 3rem; padding: 0 1.5rem; }
  @media (min-width: 1024px) { .grp-section { padding: 0 2rem; } }
  .grp-section__head { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule); margin-bottom: 1.5rem; }
  .grp-section__head h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; color: var(--ink); margin: 0; letter-spacing: -0.015em; }
  .count { font-size: 0.875rem; color: var(--ink-muted); margin-left: 0.5rem; font-weight: 400; }

  .grp-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  @media (min-width: 768px) { .grp-grid { grid-template-columns: repeat(2, 1fr); } }

  .grp-card {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--rule);
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
    border-radius: 0.375rem;
  }
  .grp-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .grp-card--disbanded { opacity: 0.65; }
  .grp-card__id {
    display: block;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .grp-card__title {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
    line-height: 1.4;
  }
  .grp-card__convenor {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    color: var(--ink-muted);
  }
</style>
