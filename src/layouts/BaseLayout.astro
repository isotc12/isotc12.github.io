---
import '../styles/main.css'
import { committee } from '../data/committee'
import { mainNav } from '../data/navigation'

interface Props {
  title?: string
  description?: string
  noIndex?: boolean
}

const {
  title,
  description = committee.scope,
  noIndex = false,
} = Astro.props

const pageTitle = title
  ? `${title} — ${committee.name}`
  : `${committee.name} — ${committee.tagline}`

const path = Astro.url.pathname
const isActive = (to: string): boolean => {
  if (to === '/') return path === '/'
  return path === to || path.startsWith(to + '/') || path.startsWith(to)
}
const sectionContains = (item: { to: string; children?: { to: string }[] }): boolean =>
  isActive(item.to) || (item.children?.some((c) => isActive(c.to)) ?? false)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      const theme = (() => {
        try {
          const stored = localStorage.getItem('theme')
          if (stored === 'light' || stored === 'dark') return stored
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        } catch { return 'light' }
      })()
      if (theme === 'dark') document.documentElement.classList.add('dark')
    </script>
  </head>
  <body>
    <div class="brand-bar" aria-hidden="true"></div>

    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-logo">
          <img src="/assets/iso-red.svg" alt="ISO" class="site-logo__mark" />
          <span class="site-logo__text">
            <span class="site-logo__name">{committee.name}</span>
            <span class="site-logo__sub">{committee.short_title}</span>
          </span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          {mainNav.map((item) => (
            item.children?.length ? (
              <div class="site-nav__group">
                <a href={item.to} class:list={['site-nav__item', { 'is-active': sectionContains(item) }]}>
                  {item.label}
                  <svg viewBox="0 0 12 12" fill="currentColor"><path d="M6 8L2 4h8z" /></svg>
                </a>
                <div class="site-nav__menu">
                  <div class="site-nav__menu-inner">
                    {item.children.map((child) => (
                      <a href={child.to} class:list={['site-nav__menu-item', { 'is-active': isActive(child.to) }]}>{child.label}</a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.to} class:list={['site-nav__item', { 'is-active': isActive(item.to) }]}>{item.label}</a>
            )
          ))}
        </nav>

        <div class="site-actions">
          <button type="button" class="site-action-btn" id="theme-toggle" aria-label="Toggle theme">
            <svg class="icon-sun" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <svg class="icon-moon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="display:none"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="site-action-btn site-action-btn--mobile" id="mobile-toggle" aria-label="Menu" aria-expanded="false">
            <svg class="icon-menu" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 6l12 12M6 18L18 6"/></svg>
          </button>
        </div>
      </div>
    </header>

    <div class="mobile-menu" id="mobile-menu" hidden>
      <div class="mobile-menu__section">
        <p class="mobile-menu__label">Main</p>
        {mainNav.map((item) => (
          <>
            <a href={item.to} class="mobile-menu__link">{item.label}</a>
            {item.children?.map((c) => (
              <a href={c.to} class="mobile-menu__link mobile-menu__link--sub">{c.label}</a>
            ))}
          </>
        ))}
      </div>
    </div>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__grid">
          <div class="site-footer__brand-cell">
            <a href="/" class="site-footer__logo">
              <img src="/assets/iso-red.svg" alt="ISO" />
              <span class="site-footer__logo-text">{committee.name}</span>
            </a>
            <p class="site-footer__tagline">{committee.tagline}. {committee.short_title}.</p>
          </div>

          <div>
            <p class="site-footer__heading">Committee</p>
            <ul class="site-footer__list">
              <li><strong>Secretariat</strong> {committee.secretariat}</li>
              <li><strong>Chair</strong> {committee.chair}</li>
              <li><strong>Established</strong> {committee.established}</li>
            </ul>
          </div>

          <div>
            <p class="site-footer__heading">Explore</p>
            <ul class="site-footer__list">
              <li><a href="/standards/">Standards</a></li>
              <li><a href="/national-bodies/">National bodies</a></li>
              <li><a href="/meetings/">Meetings</a></li>
              <li><a href="/decisions/">Resolutions</a></li>
              <li><a href="/history/">History</a></li>
            </ul>
          </div>

          <div>
            <p class="site-footer__heading">External</p>
            <ul class="site-footer__list">
              <li><a href={committee.links.isoCommittee} target="_blank" rel="noopener noreferrer">ISO committee page ↗</a></li>
              <li><a href={committee.links.committeeSite} target="_blank" rel="noopener noreferrer">Committee site ↗</a></li>
              <li><a href={committee.links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
              <li><a href="https://www.bipm.org/en/measurement-units/si-brochure" target="_blank" rel="noopener noreferrer">BIPM SI Brochure ↗</a></li>
            </ul>
          </div>
        </div>
        <div class="site-footer__bottom">
          <p class="site-footer__copy">© {new Date().getFullYear()} {committee.name}</p>
          <p class="site-footer__copy">{committee.short_title}</p>
        </div>
      </div>
    </footer>

    <script>
      const themeToggle = document.getElementById('theme-toggle')
      const iconSun = themeToggle?.querySelector('.icon-sun')
      const iconMoon = themeToggle?.querySelector('.icon-moon')
      const syncThemeIcon = () => {
        const isDark = document.documentElement.classList.contains('dark')
        if (iconSun) (iconSun as SVGElement).style.display = isDark ? 'none' : 'block'
        if (iconMoon) (iconMoon as SVGElement).style.display = isDark ? 'block' : 'none'
      }
      syncThemeIcon()
      themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark')
        localStorage.setItem('theme', isDark ? 'dark' : 'light')
        syncThemeIcon()
      })

      const mobileToggle = document.getElementById('mobile-toggle')
      const mobileMenu = document.getElementById('mobile-menu')
      mobileToggle?.addEventListener('click', () => {
        const hidden = mobileMenu?.hasAttribute('hidden')
        if (hidden) {
          mobileMenu?.removeAttribute('hidden')
          document.body.classList.add('menu-open')
          mobileToggle.setAttribute('aria-expanded', 'true')
        } else {
          mobileMenu?.setAttribute('hidden', '')
          document.body.classList.remove('menu-open')
          mobileToggle.setAttribute('aria-expanded', 'false')
        }
      })
    </script>
  </body>
</html>
