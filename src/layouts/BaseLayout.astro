---
import '../styles/main.css'
import { committee } from '../data/committee'
import { mainNav } from '../data/navigation'

interface Props {
  title?: string
  description?: string
  bodyClass?: string
  noIndex?: boolean
}

const {
  title,
  description = committee.scope,
  bodyClass = '',
  noIndex = false,
} = Astro.props

const pageTitle = title
  ? `${title} · ${committee.name}`
  : `${committee.name} — ${committee.tagline}`

const path = Astro.url.pathname
function isActive(to: string): boolean {
  if (to === '/') return path === '/'
  return path === to || path.startsWith(to + '/') || path.startsWith(to)
}
function sectionContains(item: { to: string; children?: { to: string }[] }): boolean {
  if (isActive(item.to)) return true
  return item.children?.some((c) => isActive(c.to)) ?? false
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      const theme = (() => {
        try {
          const stored = localStorage.getItem('theme')
          if (stored === 'light' || stored === 'dark') return stored
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        } catch {
          return 'light'
        }
      })()
      if (theme === 'dark') document.documentElement.classList.add('dark')
    </script>
  </head>
  <body class={bodyClass}>
    <div class="site-brand-bar" aria-hidden="true"></div>

    <header id="nav-header" class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-header__logo">
          <img src="/assets/iso-red.svg" alt="ISO" />
          <span class="site-header__logo-text">
            {committee.name}
            <span class="site-header__logo-subtitle">{committee.short_title}</span>
          </span>
        </a>

        <nav class="site-header__nav" aria-label="Primary">
          {mainNav.map((item) => (
            item.children?.length ? (
              <div class="site-header__nav-group">
                <a href={item.to} class:list={['site-header__nav-link', { 'is-active': sectionContains(item) }]}>
                  {item.label}
                  <svg viewBox="0 0 12 12" fill="currentColor" style="width:0.75rem;height:0.75rem;opacity:0.4"><path d="M6 8L2 4h8z" /></svg>
                </a>
                <div class="site-header__dropdown">
                  <div class="site-header__dropdown-inner">
                    {item.children.map((child) => (
                      <a href={child.to} class:list={['site-header__dropdown-item', { 'is-active': isActive(child.to) }]}>{child.label}</a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.to} class:list={['site-header__nav-link', { 'is-active': isActive(item.to) }]}>{item.label}</a>
            )
          ))}
        </nav>

        <div class="site-header__actions">
          <button type="button" class="site-header__icon-btn" id="theme-toggle" aria-label="Switch theme">
            <svg class="header-icon icon-sun" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            <svg class="header-icon icon-moon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
          </button>

          <button type="button" class="site-header__icon-btn site-header__icon-btn--mobile" id="mobile-menu-toggle" aria-label="Menu" aria-expanded="false">
            <svg class="header-icon icon-menu" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            <svg class="header-icon icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>

      <div class="mobile-menu" id="mobile-menu" hidden>
        {mainNav.flatMap((item) => {
          const items = []
          items.push({ href: item.to, label: item.label, sub: false })
          if (item.children) {
            for (const c of item.children) {
              items.push({ href: c.to, label: c.label, sub: true })
            }
          }
          return items
        }).map((link) => (
          <a href={link.href} class:list={['mobile-menu__link', { 'mobile-menu__link--sub': link.sub }]}>{link.label}</a>
        ))}
      </div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__grid">
          <div class="site-footer__brand">
            <a href="/" class="site-footer__logo">
              <img src="/assets/iso-red.svg" alt="ISO" />
              <span class="site-footer__logo-text">{committee.name}</span>
            </a>
            <p class="site-footer__tagline">{committee.tagline}</p>
            <p class="site-footer__tagline">{committee.scope}</p>
          </div>

          <div>
            <h4 class="site-footer__heading">Committee</h4>
            <ul class="site-footer__facts">
              <li><strong>Secretariat:</strong> {committee.secretariat}</li>
              <li><strong>Chair:</strong> {committee.chair}</li>
              <li><strong>Established:</strong> {committee.established}</li>
            </ul>
          </div>

          <div>
            <h4 class="site-footer__heading">Explore</h4>
            <ul class="site-footer__links">
              <li><a href="/standards/" class="site-footer__link">Standards</a></li>
              <li><a href="/members/" class="site-footer__link">National bodies</a></li>
              <li><a href="/meetings/" class="site-footer__link">Meetings</a></li>
              <li><a href="/decisions/" class="site-footer__link">Resolutions</a></li>
              <li><a href="/about/" class="site-footer__link">About</a></li>
            </ul>
          </div>

          <div>
            <h4 class="site-footer__heading">External</h4>
            <ul class="site-footer__links">
              <li><a href={committee.links.iso} class="site-footer__link" target="_blank" rel="noopener noreferrer">ISO.org</a></li>
              <li><a href={committee.links.isoCommittee} class="site-footer__link" target="_blank" rel="noopener noreferrer">ISO committee page</a></li>
              <li><a href={committee.links.committeeSite} class="site-footer__link" target="_blank" rel="noopener noreferrer">Committee site</a></li>
              <li><a href={committee.links.github} class="site-footer__link" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="site-footer__bottom">
          <p class="site-footer__copy">© {new Date().getFullYear()} {committee.name} · {committee.short_title}</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle')
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark')
        localStorage.setItem('theme', isDark ? 'dark' : 'light')
      })

      const mobileButton = document.getElementById('mobile-menu-toggle')
      const mobileMenu = document.getElementById('mobile-menu')
      mobileButton?.addEventListener('click', () => {
        const isHidden = mobileMenu?.hasAttribute('hidden')
        if (isHidden) {
          mobileMenu?.removeAttribute('hidden')
          document.body.classList.add('menu-open')
          mobileButton.setAttribute('aria-expanded', 'true')
        } else {
          mobileMenu?.setAttribute('hidden', '')
          document.body.classList.remove('menu-open')
          mobileButton.setAttribute('aria-expanded', 'false')
        }
      })
    </script>
  </body>
</html>
