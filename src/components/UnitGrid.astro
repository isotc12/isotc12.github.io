---
interface BaseUnit {
  symbol: string
  name: string
  quantity: string
  dimension: string
  part: string
  href: string
}

// The seven SI base units — TC 12's foundational subject matter.
const units: BaseUnit[] = [
  { symbol: 'm',   name: 'metre',         quantity: 'length',                    dimension: 'L', part: '80000-3',  href: '/standards/iso-80000-3/' },
  { symbol: 'kg',  name: 'kilogram',      quantity: 'mass',                      dimension: 'M', part: '80000-4',  href: '/standards/iso-80000-4/' },
  { symbol: 's',   name: 'second',        quantity: 'time',                      dimension: 'T', part: '80000-3',  href: '/standards/iso-80000-3/' },
  { symbol: 'A',   name: 'ampere',        quantity: 'electric current',          dimension: 'I', part: '80000-6',  href: '/standards/iso-80000-6/' },
  { symbol: 'K',   name: 'kelvin',        quantity: 'temperature',               dimension: 'Θ', part: '80000-5',  href: '/standards/iso-80000-5/' },
  { symbol: 'mol', name: 'mole',          quantity: 'amount of substance',       dimension: 'N', part: '80000-9',  href: '/standards/iso-80000-9/' },
  { symbol: 'cd',  name: 'candela',       quantity: 'luminous intensity',        dimension: 'J', part: '80000-7',  href: '/standards/iso-80000-7/' },
]

interface Props {
  variant?: 'hero' | 'compact'
  interactive?: boolean
  class?: string
}

const { variant = 'hero', interactive = true, class: className = '' } = Astro.props
---

{
  variant === 'hero' ? (
    <div class:list={['unit-grid-hero stagger', className]} role="list" aria-label="The seven SI base units">
      <div class="grid grid-cols-4 gap-px bg-rule">
        {units.map((u, i) => (
          <a
            href={interactive ? u.href : undefined}
            role="listitem"
            class:list={[
              'group bg-paper hover:bg-vellum transition-all duration-200 px-4 sm:px-7 py-8 sm:py-12 relative',
              i === 4 && 'sm:col-start-2',
            ]}
          >
            <div class="absolute top-3 right-3 sm:top-4 sm:right-4 font-mono text-[0.65rem] text-faint group-hover:text-wine transition-colors tabular-nums">
              {String(i + 1).padStart(2, '0')}
            </div>
            <div class="font-mono text-[0.7rem] text-wine mb-4 sm:mb-6 tracking-wider">[{u.dimension}]</div>
            <div class="font-mono font-medium leading-[0.85] text-[3.5rem] sm:text-[6rem] tracking-[-0.04em] text-ink group-hover:text-wine transition-colors">
              {u.symbol}
            </div>
            <div class="mt-5 sm:mt-7">
              <div class="font-display text-sm sm:text-base text-ink">{u.name}</div>
              <div class="text-xs text-muted mt-1 italic font-display">{u.quantity}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class:list={['inline-grid grid-cols-7 gap-3', className]} role="list" aria-label="SI base units">
      {units.map((u) => (
        <div role="listitem" class="text-center">
          <div class="font-mono text-base font-medium">{u.symbol}</div>
          <div class="text-[0.6rem] text-muted uppercase tracking-wide">{u.dimension}</div>
        </div>
      ))}
    </div>
  )
}
