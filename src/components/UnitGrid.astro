---
import DefiningConstants from './DefiningConstants.astro'

interface BaseUnit {
  symbol: string
  name: string
  quantity: string
  dimension: string
  href: string
}

// The seven SI base units, in the order their defining constants appear
// in the SI Brochure.
const units: BaseUnit[] = [
  { symbol: 's',   name: 'second',     quantity: 'time',                 dimension: 'T', href: '/standards/iso-80000-3/' },
  { symbol: 'm',   name: 'metre',      quantity: 'length',               dimension: 'L', href: '/standards/iso-80000-3/' },
  { symbol: 'kg',  name: 'kilogram',   quantity: 'mass',                 dimension: 'M', href: '/standards/iso-80000-4/' },
  { symbol: 'A',   name: 'ampere',     quantity: 'electric current',     dimension: 'I', href: '/standards/iso-80000-6/' },
  { symbol: 'K',   name: 'kelvin',     quantity: 'temperature',          dimension: 'Θ', href: '/standards/iso-80000-5/' },
  { symbol: 'mol', name: 'mole',       quantity: 'amount of substance',  dimension: 'N', href: '/standards/iso-80000-9/' },
  { symbol: 'cd',  name: 'candela',    quantity: 'luminous intensity',   dimension: 'J', href: '/standards/iso-80000-7/' },
]

interface Props {
  variant?: 'grid' | 'compact'
  class?: string
}
const { variant = 'grid', class: className = '' } = Astro.props
---

{
  variant === 'grid' ? (
    <div class:list={['unit-grid', className]} role="list" aria-label="SI base units">
      {units.map((u, i) => (
        <a href={u.href} class="unit" role="listitem">
          <span class="unit__dim">[{u.dimension}]</span>
          <span class="unit__symbol">{u.symbol}</span>
          <span class="unit__name">{u.name}</span>
          <span class="unit__quantity">{u.quantity}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class:list={['unit-strip', className]} role="list" aria-label="SI base units">
      {units.map((u) => (
        <span class="unit-strip__item" role="listitem">
          <span class="unit-strip__symbol">{u.symbol}</span>
          <span class="unit-strip__dim">{u.dimension}</span>
        </span>
      ))}
    </div>
  )
}

<style>
  .unit-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule-strong);
    border-left: 1px solid var(--rule-strong);
  }
  @media (min-width: 768px) { .unit-grid { grid-template-columns: repeat(4, 1fr); } }

  .unit {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 0.5rem;
    padding: 1.75rem 1.5rem 1.5rem;
    background: var(--bg);
    border-right: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
    text-decoration: none;
    color: var(--ink);
    position: relative;
    transition: background 0.18s;
    min-height: 11rem;
  }
  .unit:hover { background: var(--bg-elevated); color: var(--ink); }
  .unit:hover .unit__symbol { color: var(--accent); }

  .unit__dim {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .unit__symbol {
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 0.95;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.03em;
    transition: color 0.18s;
    margin-top: 0.5rem;
  }
  @media (min-width: 768px) { .unit__symbol { font-size: 4.5rem; } }
  .unit__name {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    margin-top: 1rem;
  }
  .unit__quantity {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .unit-strip {
    display: inline-grid;
    grid-template-columns: repeat(7, auto);
    gap: 1rem;
    align-items: baseline;
  }
  .unit-strip__item { display: flex; flex-direction: column; align-items: center; gap: 0.125rem; }
  .unit-strip__symbol {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--accent);
  }
  .unit-strip__dim {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.6875rem;
    color: var(--ink-muted);
  }
</style>
