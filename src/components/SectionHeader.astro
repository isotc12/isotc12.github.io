---
interface Props {
  eyebrow?: string
  title: string
  ordinal?: string
  href?: string
  align?: 'left' | 'center'
  class?: string
}

const {
  eyebrow,
  title,
  ordinal,
  href,
  align = 'left',
  class: className = '',
} = Astro.props
---

<section class:list={['max-w-[1320px] mx-auto px-6 lg:px-10', className]}>
  <div class:list={['hairline pt-8', align === 'center' && 'text-center']}>
    <div class:list={['flex items-baseline gap-3', align === 'center' && 'justify-center']}>
      {ordinal && <span class="font-mono text-sm text-wine">{ordinal}</span>}
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    </div>
    {href ? (
      <h2 class="font-display font-medium tracking-tight text-[var(--text-h2)] mt-2">
        <a href={href} class="hover:text-wine transition-colors">{title}</a>
      </h2>
    ) : (
      <h2 class="font-display font-medium tracking-tight text-[var(--text-h2)] mt-2">
        {title}
      </h2>
    )}
    <slot />
  </div>
</section>
