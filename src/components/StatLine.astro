---
interface Props {
  value: string | number
  label: string
  caption?: string
  href?: string
  class?: string
}

const { value, label, caption, href, class: className = '' } = Astro.props
---

<div class:list={['stat-line', className]}>
  <div class="font-mono text-3xl sm:text-4xl font-medium tracking-tight text-ink">
    {href ? <a href={href} class="hover:text-wine transition-colors">{value}</a> : value}
  </div>
  <div class="eyebrow mt-2">{label}</div>
  {caption && (
    <div class="text-sm text-muted mt-2 leading-snug max-w-[18ch]">{caption}</div>
  )}
</div>
