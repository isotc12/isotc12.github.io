---
interface Props {
  eyebrow?: string
  title: string
  lead?: string
  class?: string
}
const { eyebrow, title, lead, class: className = '' } = Astro.props
---

<header class:list={['page-hero', className]}>
  {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
  <h1 class="page-hero__title" set:html={title} />
  {lead && <p class="page-hero__lead" set:html={lead} />}
  <slot />
</header>
