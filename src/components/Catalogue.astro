---
// The structure of ISO/IEC 80000 — TC 12's actual published work.
// Fifteen parts, organised by domain. Each part standardises the names,
// symbols, definitions, and units for quantities in that domain.
// This is the catalogue of TC 12's output.

interface CatalogueEntry {
  ref: string
  part: number
  title: string
  scope: string
  dimensions: string[]
  domain: string
  status: 'published' | 'development' | 'revision' | 'withdrawn'
  edition?: number
  isIEC?: boolean
}

const entries: CatalogueEntry[] = [
  { ref: 'ISO 80000-1',  part: 1,  title: 'General',                          scope: 'General definitions, the ISQ framework, notation, and printing rules.',                 dimensions: ['—'],         domain: 'framework',   status: 'published',  edition: 2022 },
  { ref: 'ISO 80000-2',  part: 2,  title: 'Mathematics',                      scope: 'Mathematical signs and symbols used in science and technology.',                       dimensions: ['—'],         domain: 'mathematics', status: 'revision' },
  { ref: 'ISO 80000-3',  part: 3,  title: 'Space and time',                   scope: 'Quantities and units of space and time — length, angle, duration, velocity.',          dimensions: ['L','T'],     domain: 'physics',     status: 'published',  edition: 2019 },
  { ref: 'ISO 80000-4',  part: 4,  title: 'Mechanics',                        scope: 'Mechanical quantities — force, energy, pressure, mass density.',                       dimensions: ['L','M','T'], domain: 'physics',     status: 'revision' },
  { ref: 'ISO 80000-5',  part: 5,  title: 'Thermodynamics',                   scope: 'Thermodynamic quantities — temperature, entropy, heat, enthalpy.',                     dimensions: ['Θ','L','M','T'], domain: 'physics', status: 'published',  edition: 2019 },
  { ref: 'ISO 80000-6',  part: 6,  title: 'Electromagnetism',                 scope: 'Electromagnetic quantities — current, voltage, capacitance, resistance.',              dimensions: ['I','L','M','T'], domain: 'physics', status: 'published',  edition: 2022, isIEC: true },
  { ref: 'ISO 80000-7',  part: 7,  title: 'Light and radiation',              scope: 'Optical radiation quantities — radiant and luminous intensity, flux.',                 dimensions: ['J','L','M','T'], domain: 'physics', status: 'published',  edition: 2019 },
  { ref: 'ISO 80000-8',  part: 8,  title: 'Acoustics',                        scope: 'Acoustic quantities — sound pressure, intensity, power, impedance.',                   dimensions: ['L','M','T'], domain: 'physics',     status: 'published',  edition: 2020 },
  { ref: 'ISO 80000-9',  part: 9,  title: 'Physical chemistry and molecular physics', scope: 'Quantities for chemical reactions, molecular structure, thermodynamics of mixtures.', dimensions: ['N','M','T','Θ'], domain: 'chemistry', status: 'published', edition: 2019 },
  { ref: 'ISO 80000-10', part: 10, title: 'Atomic and nuclear physics',       scope: 'Atomic and nuclear quantities — half-life, cross-section, decay constant.',            dimensions: ['L','M','T'], domain: 'physics',     status: 'published',  edition: 2019 },
  { ref: 'ISO 80000-11', part: 11, title: 'Characteristic numbers',           scope: 'Dimensionless numbers used in transport phenomena — Reynolds, Mach, Prandtl.',         dimensions: ['1'],         domain: 'engineering', status: 'published',  edition: 2019 },
  { ref: 'ISO 80000-12', part: 12, title: 'Condensed matter physics',         scope: 'Solid-state quantities — conductivity, susceptibility, lattice spacing.',              dimensions: ['L','M','T','I'], domain: 'physics', status: 'published',  edition: 2019 },
  { ref: 'ISO 80000-13', part: 13, title: 'Information science and technology', scope: 'Binary prefixes — kibi, mebi, gibi, robi, quebi.',                                    dimensions: ['1'],         domain: 'information', status: 'published',  edition: 2025, isIEC: true },
  { ref: 'ISO 80000-15', part: 15, title: 'Logarithmic and related quantities', scope: 'Logarithmic quantities and their units — decibel, neper, bel.',                       dimensions: ['1'],         domain: 'information', status: 'development', isIEC: true },
  { ref: 'ISO 80000-16', part: 16, title: 'Printing and writing rules',       scope: 'Rules for printing and writing quantities and unit symbols.',                           dimensions: ['—'],         domain: 'rules',       status: 'development', isIEC: true },
]

const statusLabel: Record<string, string> = {
  published: 'Published',
  revision: 'Under revision',
  development: 'Under development',
  withdrawn: 'Withdrawn',
}
---

<section class="catalogue" aria-labelledby="catalogue-h">
  <header class="catalogue__head">
    <p class="eyebrow eyebrow--ref" id="catalogue-h">The published work</p>
    <h2 class="catalogue__title">ISO/IEC 80000 in fifteen parts</h2>
    <p class="catalogue__intro">
      TC 12's output is the <em>International System of Quantities</em>, published as the ISO/IEC 80000 series. Each part names the quantities in a domain, gives them symbols, defines them, and states the units used to express them.
    </p>
  </header>

  <ol class="catalogue__list" role="list">
    {entries.map((e, i) => (
      <li class="entry">
        <a href={`/standards/iso-80000-${e.part}/`} class="entry__link">
          <span class="entry__num num">{String(e.part).padStart(2, '0')}</span>
          <div class="entry__body">
            <div class="entry__head">
              <span class="entry__ref num">{e.ref}</span>
              <span class:list={['pill', `pill--${e.status === 'published' ? 'published' : e.status === 'withdrawn' ? 'withdrawn' : 'development'}`]}>
                <span class="pill__dot"></span>{statusLabel[e.status]}
              </span>
            </div>
            <h3 class="entry__title">{e.title}</h3>
            <p class="entry__scope">{e.scope}</p>
          </div>
          <div class="entry__dims" aria-label="Dimensions covered">
            {e.dimensions.map((d) => (
              <span class:list={['dim', d === '—' && 'dim--none']}>{d}</span>
            ))}
          </div>
        </a>
      </li>
    ))}
  </ol>

  <p class="catalogue__legend">
    <span class="dim dim--inline">L</span> length <span class="dim dim--inline">M</span> mass <span class="dim dim--inline">T</span> time <span class="dim dim--inline">I</span> current <span class="dim dim--inline">Θ</span> temperature <span class="dim dim--inline">N</span> amount <span class="dim dim--inline">J</span> luminous intensity — per ISO 80000-1.
  </p>
</section>

<style>
  .catalogue {
    border-top: 1px solid var(--rule-strong);
    padding: 3rem 0;
  }
  .catalogue__head { max-width: 56ch; margin-bottom: 2.5rem; }
  .catalogue__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 500;
    color: var(--ink);
    margin: 0.75rem 0 0;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .catalogue__intro {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink-secondary);
    margin: 1rem 0 0;
  }
  .catalogue__intro em { font-style: italic; color: var(--ink); font-weight: 500; }

  .catalogue__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }
  .entry { border-bottom: 1px solid var(--rule); }
  .entry__link {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1.5rem;
    padding: 1.5rem 0;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s;
    align-items: start;
  }
  .entry__link:hover { background: var(--bg-elevated); color: var(--ink); }
  @media (max-width: 768px) {
    .entry__link { grid-template-columns: 2rem 1fr; gap: 1rem; }
    .entry__dims { grid-column: 1 / -1; padding-left: 3rem; margin-top: 0.5rem; }
  }

  .entry__num {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink-faint);
    padding-top: 0.25rem;
    letter-spacing: 0.02em;
  }
  .entry__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .entry__ref {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
  }
  .entry__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .entry__link:hover .entry__title { color: var(--accent); }
  .entry__scope {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-muted);
    margin: 0.5rem 0 0;
    max-width: 56ch;
  }

  .entry__dims {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding-top: 0.375rem;
    max-width: 8rem;
    justify-content: flex-end;
  }
  .dim {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    line-height: 1.3;
    min-width: 1.75rem;
    text-align: center;
  }
  .dim--none { color: var(--ink-faint); background: var(--bg-elevated); font-style: normal; }
  .dim--inline { display: inline-block; margin-right: 0.25rem; vertical-align: baseline; }

  .catalogue__legend {
    margin: 2rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-muted);
    font-family: var(--font-display);
    line-height: 1.7;
    max-width: 60ch;
  }
</style>
